#!/usr/bin/env bash
# Chezmoi run_onchange script: Install packages using profile-driven dispatch
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# profiles.yaml hash: {{ include ".chezmoidata/profiles.yaml" | sha256sum }}
# Brewfile hash: {{ include "Brewfile.tmpl" | sha256sum }}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

{{ $p := index .profiles .profile -}}
log "Using profile '{{ .profile }}' (distro={{ .distro }})"

# =============================================================================
# Native package managers (install up to profile tier)
# =============================================================================
{{ if and (hasKey $p "brew") $p.brew -}}
bash <(render_template scripts/install-packages-brew.sh.tmpl)
{{ end -}}

{{ if and (hasKey $p "pacman") $p.pacman -}}
bash <(render_template scripts/install-packages-pacman.sh.tmpl)
{{ end -}}

{{ if and (hasKey $p "apt") $p.apt -}}
bash <(render_template scripts/install-packages-apt.sh.tmpl)
{{ end -}}

{{ if and (hasKey $p "dnf") $p.dnf -}}
bash <(render_template scripts/install-packages-dnf.sh.tmpl)
{{ end -}}

{{ if and (hasKey $p "flatpak") $p.flatpak -}}
bash <(render_template scripts/install-packages-flatpak.sh.tmpl)
{{ end -}}

{{ if eq .distro "silverblue" -}}
bash <(render_template scripts/install-packages-appimage.sh.tmpl)
{{ end -}}

log "Package installation complete!"
