#!/usr/bin/env bash
# Chezmoi run_onchange script: Install packages based on detected distro
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# Brewfile hash: {{ include "Brewfile.tmpl" | sha256sum }}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

DISTRO="{{ .distro }}"

log "Detected distro: $DISTRO"

{{ if eq .distro "macos" -}}
# =============================================================================
# macOS: Use Homebrew
# =============================================================================
log "Installing packages via Homebrew (macOS)..."
ensure_brew_in_path
require_cmd brew

brew bundle --file=<(render_template Brewfile.tmpl)

{{ else if eq .distro "arch" -}}
# =============================================================================
# Arch Linux: Use pacman/yay/flatpak
# =============================================================================
log "Installing packages via pacman/yay (Arch Linux)..."

bash <(render_template scripts/install-packages-pacman.sh.tmpl)

{{ else if eq .distro "debian" -}}
# =============================================================================
# Debian/Ubuntu: Use apt
# =============================================================================
log "Installing packages via apt (Debian/Ubuntu)..."

bash <(render_template scripts/install-packages-apt.sh.tmpl)

{{ else if eq .distro "silverblue" -}}
# =============================================================================
# Fedora Silverblue/Bazzite: Homebrew for CLI, Flatpak for GUI
# =============================================================================
log "Installing packages on Silverblue/Bazzite..."

bash <(render_template scripts/install-packages-silverblue.sh.tmpl)

{{ else -}}
# =============================================================================
# Unknown distro: Try Homebrew as fallback
# =============================================================================
warn "Unknown or unsupported distro: $DISTRO"
warn "Supported: macOS, Arch Linux, Debian/Ubuntu, Fedora Silverblue/Bazzite"

if command -v brew &>/dev/null; then
    log "Homebrew detected on Linux — using it as fallback..."
    ensure_brew_in_path
    brew bundle --file=<(render_template Brewfile.tmpl)
else
    fail "Cannot install packages on unsupported distro without Homebrew"
fi
{{ end -}}

log "Package installation complete!"
