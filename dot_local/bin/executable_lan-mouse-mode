#!/usr/bin/env bash
# lan-mouse-mode <mac|default>
# Called from lan-mouse's per-client enter_hook / leave_hook config fields.
#
# mac:     snapshot current input:kb_options + input:natural_scroll to a runtime
#          cache (only on first entry — idempotent across double-mac), then write
#          the Mac state.
# default: restore both from the cache and remove it. If no cache (fresh boot,
#          first call ever, or cache wiped), fall back to `hyprctl reload` which
#          restores everything from the user's config files.

set -euo pipefail

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/lan-mouse-mode.state"
MAC_KB_ADDITIONS="altwin:swap_alt_win,custom:printscreen_f13"
MAC_NATURAL_SCROLL=true

case "${1:-}" in
  mac)
    if [ ! -f "$STATE_FILE" ]; then
      cur_kb=$(hyprctl getoption -j input:kb_options | jq -r '.str // ""')
      cur_ns=$(hyprctl getoption -j input:natural_scroll | jq -r '.int // 0')
      printf '%s\n%s\n' "$cur_kb" "$cur_ns" > "$STATE_FILE"
    fi
    base_kb=$(head -n1 "$STATE_FILE")
    new_kb="${base_kb:+${base_kb},}${MAC_KB_ADDITIONS}"
    hyprctl --batch \
      "keyword input:kb_options ${new_kb} ; keyword input:natural_scroll ${MAC_NATURAL_SCROLL}"
    ;;
  default)
    if [ -f "$STATE_FILE" ]; then
      base_kb=$(sed -n '1p' "$STATE_FILE")
      base_ns=$(sed -n '2p' "$STATE_FILE")
      hyprctl --batch \
        "keyword input:kb_options ${base_kb} ; keyword input:natural_scroll ${base_ns}"
      rm -f "$STATE_FILE"
    else
      hyprctl reload
    fi
    ;;
  *)
    echo "Usage: lan-mouse-mode <mac|default>" >&2
    exit 1
    ;;
esac
