#!/usr/bin/env bash
# devpod-linuxbrew-fetch — restore ~/.linuxbrew from a public GitHub Release.
#
# Devpod on-create has no ussh token, so we can't use tb-cli. The companion
# workflow .github/workflows/devpod-linuxbrew-cache.yml builds a tarball of a
# fully-populated ~/.linuxbrew for the devpod profile and publishes it as a
# rolling GitHub Release asset. This script downloads and extracts it before
# brew bundle runs, turning the bundle into a fast no-op (or tiny delta).
#
# Idempotent: a local marker stores the manifest of the last extract; when the
# remote manifest matches and brew is usable, no download happens.
#
# All errors are non-fatal — this is an optimization. The brew bundle in
# run_onchange_10 is the source of truth and will install whatever is missing.
#
# Bypass with: SKIP_LINUXBREW_FETCH=1 (used by CI when *building* the cache).

set -uo pipefail

if [ "${SKIP_LINUXBREW_FETCH:-0}" = "1" ]; then
    printf '>> %s\n' "SKIP_LINUXBREW_FETCH=1; not fetching"
    exit 0
fi

REPO_OWNER="${DEVPOD_LINUXBREW_REPO_OWNER:-tyvsmith}"
REPO_NAME="${DEVPOD_LINUXBREW_REPO_NAME:-dotfiles}"
TAG="${DEVPOD_LINUXBREW_TAG:-linuxbrew-cache-debian12-x86_64}"
ARCHIVE="${DEVPOD_LINUXBREW_ARCHIVE:-linuxbrew-debian12-x86_64.tar.zst}"
RELEASE_BASE="https://github.com/${REPO_OWNER}/${REPO_NAME}/releases/download/${TAG}"

LOCAL_STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/devpod-linuxbrew-fetch"
LOCAL_MANIFEST="${LOCAL_STATE_DIR}/manifest.json"

mkdir -p "$LOCAL_STATE_DIR"

log()  { printf '>> %s\n' "$*"; }
warn() { printf '!! %s\n' "$*" >&2; }

# Validate by execing --version because a half-restored brew tree can leave
# dangling INTERPs that pass `[ -x ]` but fail exec.
#
# IMPORTANT: prefer system paths over $HOME/.linuxbrew because we wipe the
# brew tree before extracting. A cached path inside the soon-to-be-deleted
# tree will exec-fail mid-tar.
ensure_zstd() {
    local p
    for p in /usr/bin/zstd "$(command -v zstd 2>/dev/null)"; do
        [ -n "$p" ] && [ -x "$p" ] && "$p" --version >/dev/null 2>&1 \
            && { ZSTD="$p"; return 0; }
    done
    if command -v apt-get >/dev/null 2>&1; then
        log "zstd missing/unusable; installing via apt"
        sudo apt-get update -qq && sudo apt-get install -y zstd
        if [ -x /usr/bin/zstd ] && /usr/bin/zstd --version >/dev/null 2>&1; then
            ZSTD=/usr/bin/zstd
            return 0
        fi
    fi
    warn "zstd not available; cannot extract"
    return 1
}

ensure_jq() {
    local p
    for p in /usr/bin/jq "$(command -v jq 2>/dev/null)"; do
        [ -n "$p" ] && [ -x "$p" ] && "$p" --version >/dev/null 2>&1 \
            && { JQ="$p"; return 0; }
    done
    if command -v apt-get >/dev/null 2>&1; then
        log "jq missing; installing via apt"
        sudo apt-get update -qq && sudo apt-get install -y jq \
            && { JQ=/usr/bin/jq; return 0; }
    fi
    warn "jq not available; cannot parse manifest"
    return 1
}

manifest_field() {  # <json-string-or-empty> <field>
    [ -z "$1" ] && { echo ""; return; }
    printf '%s' "$1" | "$JQ" -r ".$2 // empty"
}

main() {
    ensure_jq || return 0

    log "fetching remote manifest from $RELEASE_BASE/manifest.json"
    local rmanifest
    rmanifest=$(curl -fsSL --retry 3 --max-time 60 "$RELEASE_BASE/manifest.json" 2>/dev/null) || {
        warn "could not fetch remote manifest; skipping"
        return 0
    }

    local r_archive
    r_archive=$(manifest_field "$rmanifest" archive)
    [ -z "$r_archive" ] && { warn "remote manifest missing 'archive' field"; return 0; }

    local l_archive=""
    if [ -f "$LOCAL_MANIFEST" ]; then
        l_archive=$(manifest_field "$(cat "$LOCAL_MANIFEST")" archive)
    fi

    if [ "$l_archive" = "$r_archive" ] && [ -x "$HOME/.linuxbrew/bin/brew" ]; then
        log "in sync ($r_archive); no download"
        return 0
    fi

    ensure_zstd || return 0

    log "downloading $RELEASE_BASE/$r_archive"
    local tmp="/tmp/${r_archive}"
    if ! curl -fL --retry 3 --max-time 1800 -o "$tmp" "$RELEASE_BASE/$r_archive"; then
        warn "download failed; skipping (brew bundle will install from scratch)"
        rm -f "$tmp"
        return 0
    fi

    # Extract into a sibling staging dir, then swap atomically. A simple
    # wipe-then-extract leaves a ~30-60s window where brew binaries don't
    # exist; an interactive fish shell (or background atuin/starship hook)
    # hitting that gap fails. Staging + rename collapses the window to two
    # mv calls, microseconds on the same filesystem.
    local stage_parent
    stage_parent=$(mktemp -d -p "$HOME" .linuxbrew-stage.XXXXXX) || {
        warn "could not create staging dir; skipping"
        rm -f "$tmp"
        return 0
    }

    log "extracting to $stage_parent"
    if ! tar -C "$stage_parent" --use-compress-program="$ZSTD -d -T0" -xf "$tmp"; then
        warn "extract failed; leaving existing ~/.linuxbrew in place"
        rm -rf "$stage_parent"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"

    if [ ! -d "$stage_parent/.linuxbrew" ]; then
        warn "archive did not contain .linuxbrew/ at root; skipping"
        rm -rf "$stage_parent"
        return 0
    fi

    local old="$HOME/.linuxbrew.old.$$"
    if [ -d "$HOME/.linuxbrew" ]; then
        log "swapping in new ~/.linuxbrew"
        mv "$HOME/.linuxbrew" "$old"
    fi
    mv "$stage_parent/.linuxbrew" "$HOME/.linuxbrew"
    rmdir "$stage_parent" 2>/dev/null || true

    if [ -d "$old" ]; then
        # Async cleanup — rm -rf of an 800MB brew tree takes seconds we don't
        # need to block on. Detached so it survives this script exiting.
        setsid -f sh -c "rm -rf '$old'" </dev/null >/dev/null 2>&1 || \
            rm -rf "$old" &
    fi

    printf '%s\n' "$rmanifest" > "$LOCAL_MANIFEST"
    if [ -x "$HOME/.linuxbrew/bin/brew" ]; then
        log "brew --prefix: $("$HOME/.linuxbrew/bin/brew" --prefix 2>/dev/null || echo unknown)"
    fi
}

main "$@"
exit 0
