#!/usr/bin/env bash
# devpod-linuxbrew-sync — sync ~/.linuxbrew with terrablob across devpods.
#
# Devpod home is the only thing persisted between restarts; ~/.linuxbrew lives
# there. To survive image bumps and skip the 10-min brew bundle on cold boots,
# we snapshot ~/.linuxbrew to terrablob (versioned, OS+arch-tagged) and restore
# it before chezmoi runs `brew bundle`.
#
# Folder/symlink setup (e.g. /home/linuxbrew/.linuxbrew → ~/.linuxbrew) is the
# caller's responsibility — this script only touches ~/.linuxbrew content.
#
# Remote layout (one set per OS+arch):
#   manifest-<platform>.json                    pointer to current archive + metadata
#   linuxbrew-<platform>-<UTC ISO>.tar.zst      versioned snapshots
#
# Local marker:
#   $XDG_CACHE_HOME/devpod-linuxbrew-sync/manifest.json
#
# Typical workflow (called from chezmoi run_before / run_after):
#   devpod-linuxbrew-sync down       # idempotent restore — no-op if local matches remote
#   chezmoi apply ...                # brew bundle either no-ops or installs deltas
#   devpod-linuxbrew-sync up         # no-op if brew unchanged; otherwise snapshot + upload + prune

set -euo pipefail

REMOTE_DIR=/prod/personal/${UBER_LDAP_UID}/linuxbrew-devpod-archive
OS_TAG="$(. /etc/os-release; echo "${ID}${VERSION_ID%%.*}")"   # e.g. debian12
ARCH_TAG="$(uname -m)"                                          # e.g. x86_64
PLATFORM="${OS_TAG}-${ARCH_TAG}"
ARCHIVE_PREFIX="linuxbrew-${PLATFORM}"
MANIFEST_NAME="manifest-${PLATFORM}.json"
REMOTE_MANIFEST="${REMOTE_DIR}/${MANIFEST_NAME}"
LOCAL_STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/devpod-linuxbrew-sync"
LOCAL_MANIFEST="${LOCAL_STATE_DIR}/manifest.json"
KEEP_VERSIONS="${DEVPOD_LINUXBREW_KEEP:-10}"

mkdir -p "$LOCAL_STATE_DIR"

log() { printf '>> %s\n' "$*"; }
warn() { printf '!! %s\n' "$*" >&2; }

# zstd: needed for tar (de)compression. Validate by execing --version because a
# half-restored brew tree can leave dangling INTERPs that pass `[ -x ]` but fail exec.
ensure_zstd() {
    local p
    for p in "$(command -v zstd 2>/dev/null)" \
             /home/linuxbrew/.linuxbrew/bin/zstd \
             "$HOME/.linuxbrew/bin/zstd" \
             /usr/bin/zstd; do
        [ -n "$p" ] && [ -x "$p" ] && "$p" --version >/dev/null 2>&1 && { ZSTD="$p"; return; }
    done
    if command -v apt-get >/dev/null 2>&1; then
        log "zstd missing/unusable; installing via apt"
        sudo apt-get update -qq && sudo apt-get install -y zstd
        if [ -x /usr/bin/zstd ] && /usr/bin/zstd --version >/dev/null 2>&1; then
            ZSTD=/usr/bin/zstd
            return
        fi
    fi
    echo "zstd not found and could not auto-install" >&2; exit 1
}

ensure_jq() {
    local p
    for p in "$(command -v jq 2>/dev/null)" \
             /home/linuxbrew/.linuxbrew/bin/jq \
             "$HOME/.linuxbrew/bin/jq" \
             /usr/bin/jq; do
        [ -n "$p" ] && [ -x "$p" ] && "$p" --version >/dev/null 2>&1 && { JQ="$p"; return; }
    done
    if command -v apt-get >/dev/null 2>&1; then
        log "jq missing; installing via apt"
        sudo apt-get update -qq && sudo apt-get install -y jq
        JQ=/usr/bin/jq && return
    fi
    echo "jq not found and could not auto-install" >&2; exit 1
}

# Stable hash of installed packages — same set + same versions = same fingerprint.
brew_fingerprint() {
    local brew="$HOME/.linuxbrew/bin/brew"
    [ -x "$brew" ] || { echo ""; return; }
    "$brew" list --formula --versions 2>/dev/null | sort | sha256sum | awk '{print $1}'
}

# Fetch remote manifest JSON to stdout; empty if missing or unreachable.
fetch_remote_manifest() {
    local tmp; tmp=$(mktemp)
    if tb-cli -t 2m get "$REMOTE_MANIFEST" "$tmp" >/dev/null 2>&1; then
        cat "$tmp"
    fi
    rm -f "$tmp"
}

manifest_field() {  # manifest_field <json-string-or-empty> <field>
    [ -z "$1" ] && { echo ""; return; }
    echo "$1" | "$JQ" -r ".$2 // empty"
}

local_manifest_json() {
    [ -f "$LOCAL_MANIFEST" ] && cat "$LOCAL_MANIFEST" || echo ""
}

cmd_info() {
    cat <<EOF
PLATFORM        = $PLATFORM
REMOTE_DIR      = $REMOTE_DIR
REMOTE_MANIFEST = $REMOTE_MANIFEST
ARCHIVE_PREFIX  = $ARCHIVE_PREFIX
LOCAL_MANIFEST  = $LOCAL_MANIFEST
KEEP_VERSIONS   = $KEEP_VERSIONS
EOF
}

cmd_status() {
    ensure_jq
    local rmanifest lmanifest live_fp
    rmanifest=$(fetch_remote_manifest)
    lmanifest=$(local_manifest_json)
    live_fp=$(brew_fingerprint)

    cmd_info
    echo
    echo "[remote manifest]"; [ -n "$rmanifest" ] && echo "$rmanifest" | "$JQ" . || echo "(none)"
    echo
    echo "[local marker]"; [ -n "$lmanifest" ] && echo "$lmanifest" | "$JQ" . || echo "(none)"
    echo
    echo "[live brew fingerprint] ${live_fp:-(brew not usable)}"

    local r_archive l_archive l_fp
    r_archive=$(manifest_field "$rmanifest" current)
    l_archive=$(manifest_field "$lmanifest" current)
    l_fp=$(manifest_field "$lmanifest" brew_fingerprint)

    echo
    [ "$r_archive" = "$l_archive" ] && [ -n "$r_archive" ] \
        && echo "drift: local marker matches remote ✓" \
        || echo "drift: local=${l_archive:-none} remote=${r_archive:-none}  → 'down' would restore"
    [ "$live_fp" = "$l_fp" ] && [ -n "$live_fp" ] \
        && echo "drift: live brew matches local marker ✓" \
        || echo "drift: live brew differs from marker  → 'up' would snapshot"
}

cmd_down() {
    ensure_zstd
    ensure_jq

    local rmanifest r_archive l_archive
    rmanifest=$(fetch_remote_manifest)
    if [ -z "$rmanifest" ]; then
        warn "no remote manifest (nothing to restore yet); skipping"
        return 0
    fi
    r_archive=$(manifest_field "$rmanifest" current)
    [ -n "$r_archive" ] || { warn "remote manifest missing 'current'"; return 1; }
    l_archive=$(manifest_field "$(local_manifest_json)" current)

    if [ "$l_archive" = "$r_archive" ] && [ -x "$HOME/.linuxbrew/bin/brew" ]; then
        log "in sync ($r_archive); no download"
        return 0
    fi

    log "restoring: local=${l_archive:-none} → remote=$r_archive"
    local archive_path="${REMOTE_DIR}/${r_archive}" tmp="/tmp/${r_archive}"
    tb-cli -t 30m get -m -k "$archive_path" "$tmp"

    if [ -d "$HOME/.linuxbrew" ] && [ -n "$(ls -A "$HOME/.linuxbrew" 2>/dev/null)" ]; then
        log "wiping existing ~/.linuxbrew before extract"
        rm -rf "$HOME/.linuxbrew"
    fi
    mkdir -p "$HOME/.linuxbrew"

    log "extracting"
    tar -C "$HOME" --use-compress-program="$ZSTD -d -T0" -xf "$tmp"
    rm -f "$tmp"

    echo "$rmanifest" > "$LOCAL_MANIFEST"
    log "brew --prefix: $("$HOME/.linuxbrew/bin/brew" --prefix)"
}

cmd_up() {
    ensure_zstd
    ensure_jq
    [ -d "$HOME/.linuxbrew" ] || { warn "no ~/.linuxbrew to snapshot"; exit 1; }

    local force=0
    [ "${1:-}" = "--force" ] && force=1

    local live_fp marker_fp
    live_fp=$(brew_fingerprint)
    marker_fp=$(manifest_field "$(local_manifest_json)" brew_fingerprint)

    if [ "$force" = 0 ] && [ -n "$live_fp" ] && [ "$live_fp" = "$marker_fp" ]; then
        log "brew fingerprint unchanged from marker; no upload (use --force to override)"
        return 0
    fi

    local ts archive tmp sz
    ts=$(date -u +%Y%m%dT%H%M%SZ)
    archive="${ARCHIVE_PREFIX}-${ts}.tar.zst"
    tmp="/tmp/${archive}"

    log "tarring ~/.linuxbrew → $tmp (zstd -T0 -10)"
    tar -C "$HOME" \
        --use-compress-program="$ZSTD -T0 -10" \
        --exclude='.linuxbrew/Caskroom' \
        --exclude='.linuxbrew/var/homebrew/locks' \
        --exclude='.linuxbrew/Library/Logs' \
        -cf "$tmp" \
        .linuxbrew

    sz=$(stat -c%s "$tmp")
    log "archive size: $(numfmt --to=iec --suffix=B "$sz")"

    log "uploading $archive"
    tb-cli -t 30m put -p -m -k -C 8 -V -2 "$tmp" "${REMOTE_DIR}/${archive}"

    log "writing manifest"
    local mtmp=/tmp/devpod-linuxbrew-sync-manifest.json
    "$JQ" -n \
        --arg current "$archive" \
        --arg uploaded_at "$ts" \
        --arg brew_fingerprint "$live_fp" \
        --arg platform "$PLATFORM" \
        --argjson archive_size "$sz" \
        '{current:$current, uploaded_at:$uploaded_at, brew_fingerprint:$brew_fingerprint, platform:$platform, archive_size:$archive_size}' \
        > "$mtmp"
    tb-cli -t 5m put -p -V -2 "$mtmp" "$REMOTE_MANIFEST"
    cp "$mtmp" "$LOCAL_MANIFEST"
    rm -f "$tmp" "$mtmp"

    cmd_prune
}

cmd_prune() {
    log "pruning archives, keeping $KEEP_VERSIONS most recent"
    local current; current=$(manifest_field "$(local_manifest_json)" current)

    local all; all=$(tb-cli ls "$REMOTE_DIR" 2>/dev/null \
        | awk '{print $NF}' \
        | grep -E "^${ARCHIVE_PREFIX}-[0-9TZ]+\.tar\.zst$" \
        | sort -r || true)
    [ -z "$all" ] && { log "no archives found"; return 0; }

    local count=0
    while IFS= read -r name; do
        count=$((count+1))
        [ "$count" -le "$KEEP_VERSIONS" ] && continue
        if [ "$name" = "$current" ]; then
            log "skip prune of pinned $name"
            continue
        fi
        log "deleting $name"
        tb-cli delete "${REMOTE_DIR}/${name}" >/dev/null 2>&1 \
            || warn "failed to delete $name"
    done <<< "$all"
}

cmd_ls() {
    tb-cli ls -l "$REMOTE_DIR"
}

case "${1:-}" in
    up)     shift; cmd_up "$@" ;;
    down)   cmd_down ;;
    status) cmd_status ;;
    prune)  ensure_jq; cmd_prune ;;
    ls)     cmd_ls ;;
    info)   cmd_info ;;
    *)      cat <<EOF
usage: $(basename "$0") <command>

  down      restore ~/.linuxbrew from terrablob if remote is newer (idempotent)
  up        snapshot + upload + prune; no-op if brew unchanged (--force to override)
  status    show local marker, remote manifest, live brew, and any drift
  prune     keep \$DEVPOD_LINUXBREW_KEEP most recent archives (default 10)
  ls        list remote dir contents
  info      show resolved paths and config

Note: this script does not create /home/linuxbrew/.linuxbrew; the caller
(run_before_00-devpod-bootstrap.sh) is responsible for the symlink setup.
EOF
            exit 1 ;;
esac
