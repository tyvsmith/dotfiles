#!/usr/bin/env bash

# Persistent companion service for lan-mouse. Waits for an active
# client connection, then monitors cursor position to toggle Hyprland
# input settings when the cursor moves to the remote client.
#
# Features (all opt-in via flags):
#   --natural-scroll      Toggle natural scrolling on the Razer mouse dock
#   --swap-keys           Swap alt/win on the Keychron keyboard
#   --remap-printscreen   Remap PrtScr to F13 on the Keychron keyboard
#   --quiet / -q          Suppress log output

set -euo pipefail

# --- Defaults ---
QUIET=false
NATURAL_SCROLL=false
SWAP_KEYS=false
REMAP_PRINTSCREEN=false

# --- Device lists ---
# Base device names to act on. Hyprland appends a numeric suffix
# (-1, -2, ...) to duplicate device names after port changes or
# reboots, and one physical device can register under several names.
# Each base is matched against the live device list at runtime, so
# every current variant is covered without hardcoding suffixes.
NATURAL_SCROLL_DEVICES=(razer-razer-mouse-dock-pro)
KEYBOARD_DEVICES=(
  keychron-keychron-ultra-link-8k-keyboard
  keychron-keychron-k6-pro
)

# --- Parse flags ---
while [[ $# -gt 0 ]]; do
  case "$1" in
    -q|--quiet)          QUIET=true ;;
    --natural-scroll)    NATURAL_SCROLL=true ;;
    --swap-keys)         SWAP_KEYS=true ;;
    --remap-printscreen) REMAP_PRINTSCREEN=true ;;
    -h|--help)
      cat <<'EOF'
Usage: lan-mouse-extended [OPTIONS]

Companion service for lan-mouse that toggles Hyprland input settings
when the cursor moves to a remote client.

Options:
  --natural-scroll      Toggle natural scrolling (Razer mouse dock)
  --swap-keys           Swap alt/win keys (Keychron keyboard)
  --remap-printscreen   Remap PrtScr to F13 (Keychron keyboard)
  -q, --quiet           Suppress log output
  -h, --help            Show this help
EOF
      exit 0
      ;;
    *) echo "Unknown option: $1" >&2; exit 1 ;;
  esac
  shift
done

# Require at least one feature flag
if ! $NATURAL_SCROLL && ! $SWAP_KEYS && ! $REMAP_PRINTSCREEN; then
  echo "Error: specify at least one of --natural-scroll, --swap-keys, --remap-printscreen" >&2
  exit 1
fi

log() { $QUIET || echo "[lan-mouse-extended] $*"; }

SOCKET="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/lan-mouse-socket.sock"

# --- Guard against duplicate instances ---
PIDFILE="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/lan-mouse-extended.pid"
if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  log "Already running (pid $(cat "$PIDFILE")), exiting"
  exit 0
fi
echo $$ > "$PIDFILE"
trap 'rm -f "$PIDFILE"' EXIT

# --- State tracking ---
IS_LINUX=true
CURRENT_X=999

# --- Input setting functions ---

# Print the live device names matching any of the given base names.
# A base matches itself exactly or with a numeric -N suffix that
# Hyprland appends to duplicates. Both the mice and keyboards lists
# are searched, since one physical device can appear in either.
resolve_devices() {
  local bases=("$@") name base
  hyprctl devices -j 2>/dev/null \
    | jq -r '.mice[].name, .keyboards[].name' \
    | while IFS= read -r name; do
        [ -n "$name" ] || continue
        for base in "${bases[@]}"; do
          if [[ "$name" == "$base" || "$name" =~ ^${base}-[0-9]+$ ]]; then
            echo "$name"
            break
          fi
        done
      done \
    | sort -u || true
}

# Apply a hyprctl device keyword to every device matching the bases.
apply_to_devices() {
  local property="$1" value="$2"; shift 2
  local dev
  for dev in $(resolve_devices "$@"); do
    hyprctl keyword "device[$dev]:$property" "$value" > /dev/null
  done
}

# Build the comma-joined kb_options value for the Keychron keyboards.
# Empty in Linux mode; in Mac mode it carries whichever keyboard remaps
# are enabled, so --swap-keys and --remap-printscreen share one write
# (kb_options is a single property — a second write would clobber the
# first). custom:printscreen_f13 is defined in ~/.config/xkb.
keyboard_kb_options() {
  local opts=()
  if [ "$1" = mac ]; then
    if $SWAP_KEYS; then opts+=(altwin:swap_alt_win); fi
    if $REMAP_PRINTSCREEN; then opts+=(custom:printscreen_f13); fi
  fi
  local IFS=,
  echo "${opts[*]}"
}

set_linux() {
  if $IS_LINUX; then return; fi
  log "Switching to Linux mode (cursor X=$CURRENT_X)"
  if $NATURAL_SCROLL; then
    apply_to_devices natural_scroll false "${NATURAL_SCROLL_DEVICES[@]}"
  fi
  if $SWAP_KEYS || $REMAP_PRINTSCREEN; then
    apply_to_devices kb_options "$(keyboard_kb_options linux)" "${KEYBOARD_DEVICES[@]}"
  fi
  IS_LINUX=true
}

set_mac() {
  if ! $IS_LINUX; then return; fi
  log "Switching to Mac mode (cursor X=$CURRENT_X)"
  if $NATURAL_SCROLL; then
    apply_to_devices natural_scroll true "${NATURAL_SCROLL_DEVICES[@]}"
  fi
  if $SWAP_KEYS || $REMAP_PRINTSCREEN; then
    apply_to_devices kb_options "$(keyboard_kb_options mac)" "${KEYBOARD_DEVICES[@]}"
  fi
  IS_LINUX=false
}

has_active_client() {
  [ -S "$SOCKET" ] && lan-mouse cli list 2>/dev/null | grep -q "active: true"
}

# --- Main loop ---
while true; do
  # Wait for an active client connection
  while ! has_active_client; do
    sleep 2
  done
  log "lan-mouse client active"

  # Monitor cursor position while a client is active
  while has_active_client; do
    CURRENT_X=$(hyprctl cursorpos | grep -o '^[0-9]\+')
    if ! $IS_LINUX; then
      if [ "$CURRENT_X" -gt 4 ]; then
        set_linux
      fi
    else
      if [ "$CURRENT_X" -eq 0 ]; then
        set_mac
      fi
    fi
    sleep 0.5
  done

  # Client disconnected — reset to Linux and wait
  set_linux
  log "lan-mouse client disconnected, waiting"
done
