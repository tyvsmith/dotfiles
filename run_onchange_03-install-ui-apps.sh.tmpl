#!/usr/bin/env bash
# Chezmoi run_onchange script: Install GUI applications (Tier 3)
# Separate from CLI tools so GUI apps don't slow down every chezmoi apply.
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# profiles.yaml hash: {{ include ".chezmoidata/profiles.yaml" | sha256sum }}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

{{ if .install_ui_apps -}}
log "Installing GUI applications (install_ui_apps=true)..."

{{ $p := index .profiles .profile -}}

# Platform-specific GUI app installers (brew casks, AUR native, AppImages, MAS)
bash <(render_template scripts/install-ui-apps.sh.tmpl)

# Flatpak apps (Linux only)
{{ if and (hasKey $p "flatpak") $p.flatpak -}}
bash <(render_template scripts/install-packages-flatpak.sh.tmpl)
{{ end -}}

{{ else -}}
log "Skipping GUI applications (install_ui_apps=false)."
{{ end -}}
