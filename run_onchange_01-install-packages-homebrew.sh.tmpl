#!/usr/bin/env bash
# Chezmoi run_onchange script: Install packages via Homebrew
# Used on macOS (native), Silverblue (immutable), and Debian-brew profiles.
#
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# profiles.yaml hash: {{ include ".chezmoidata/profiles.yaml" | sha256sum }}
# Brewfile hash: {{ include "Brewfile.tmpl" | sha256sum }}

{{ $p := index .profiles .profile -}}
{{ if not (and (hasKey $p "brew") $p.brew) -}}
# Profile '{{ .profile }}' does not use Homebrew — nothing to do.
exit 0
{{ else -}}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

log "Using profile '{{ .profile }}' — installing packages via Homebrew"

# =============================================================================
# Install Homebrew (Linux only — macOS ships with it or user installs manually)
# =============================================================================
{{ if ne .chezmoi.os "darwin" -}}
if ! command -v brew &>/dev/null; then
    # Install prerequisites via system package manager
    if command -v apt-get &>/dev/null; then
        log "Installing Homebrew prerequisites via apt..."
        sudo apt-get update
        sudo DEBIAN_FRONTEND=noninteractive apt-get install -y \
            build-essential curl file git procps
    elif command -v dnf &>/dev/null; then
        log "Installing Homebrew prerequisites via dnf..."
        sudo dnf install -y gcc make curl file git procps-ng
    fi

    log "Installing Homebrew..."
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
{{ end -}}

# Add brew to PATH for the rest of this session
ensure_brew_in_path
require_cmd brew

# =============================================================================
# Install packages via brew bundle
# =============================================================================
log "Running brew bundle..."
brew bundle --file=<(render_template Brewfile.tmpl)

log "Homebrew package installation complete!"
{{ end -}}
