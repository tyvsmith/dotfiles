#!/usr/bin/env bash
# Debian/Ubuntu package installer — generated from .chezmoidata/packages.yaml
#
# Uses runtime apt-cache checks to determine availability, so the same
# template works correctly on Debian Bookworm, Ubuntu 24.04, etc.
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

log "Installing packages via apt..."

# =============================================================================
# Candidate packages (all tiers, resolved to apt names)
# =============================================================================
declare -A CANDIDATE_PACKAGES  # apt_name -> display_name

# Tier 1: Core CLI tools
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $an := default $n (index $pkg "apt_name") }}
{{-   if and (eq (int $pkg.tier) 1) (not (hasKey $pkg "os")) (or (not (hasKey $pkg "brew")) $pkg.brew) }}
CANDIDATE_PACKAGES[{{ $an }}]="{{ $n }}"
{{-   end }}
{{- end }}

{{ if .is_dev -}}
# Tier 2: Development tools
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $an := default $n (index $pkg "apt_name") }}
{{-   if and (eq (int $pkg.tier) 2) (not (hasKey $pkg "os")) (or (not (hasKey $pkg "brew")) $pkg.brew) }}
CANDIDATE_PACKAGES[{{ $an }}]="{{ $n }}"
{{-   end }}
{{- end }}
{{ end -}}

# =============================================================================
# Update package cache
# =============================================================================
log "Updating apt cache..."
sudo apt-get update

# =============================================================================
# Check availability and split into installable vs missing
# =============================================================================
APT_PACKAGES=()
MISSING_PACKAGES=()

for apt_name in "${!CANDIDATE_PACKAGES[@]}"; do
    if apt-cache show "$apt_name" &>/dev/null; then
        APT_PACKAGES+=("$apt_name")
    else
        MISSING_PACKAGES+=("${CANDIDATE_PACKAGES[$apt_name]}")
    fi
done

# Sort for deterministic output
IFS=$'\n' APT_PACKAGES=($(sort <<<"${APT_PACKAGES[*]}")); unset IFS
IFS=$'\n' MISSING_PACKAGES=($(sort <<<"${MISSING_PACKAGES[*]}")); unset IFS

# =============================================================================
# Install available packages
# =============================================================================
log "Installing ${#APT_PACKAGES[@]} packages from apt repositories..."
if [[ ${#APT_PACKAGES[@]} -gt 0 ]]; then
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${APT_PACKAGES[@]}"
fi

# =============================================================================
# Create symlinks for renamed binaries
# =============================================================================
log "Creating symlinks for renamed binaries..."
mkdir -p ~/.local/bin
{{- range $key, $pkg := .packages }}
{{-   if hasKey $pkg "apt_bin" }}

if command -v {{ $pkg.apt_bin }} &>/dev/null && ! command -v {{ $key }} &>/dev/null; then
    ln -sf "$(command -v {{ $pkg.apt_bin }})" ~/.local/bin/{{ $key }}
    log "Created {{ $key }} -> {{ $pkg.apt_bin }} symlink"
fi
{{-   end }}
{{- end }}

# =============================================================================
# Warn about missing packages
# =============================================================================
if [[ ${#MISSING_PACKAGES[@]} -gt 0 ]]; then
    warn "The following packages are not available in your apt repositories:"
    for pkg in "${MISSING_PACKAGES[@]}"; do
        warn "  - $pkg"
    done
    log ""
    log "To install missing tools, consider:"
    log "  1. Rust toolchain: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
    log "  2. cargo install <package>"
    log "  3. Alternative package sources (PPAs, third-party repos)"
    log "  4. Re-run with --homebrew flag to use Homebrew on Linux"
fi

log ""
log "apt package installation complete!"
