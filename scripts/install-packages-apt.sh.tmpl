#!/usr/bin/env bash
# Debian/Ubuntu package installer — generated from .chezmoidata/packages.yaml
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

log "Installing packages via apt..."

# =============================================================================
# Collect packages available in apt
# =============================================================================
APT_PACKAGES=(
    # Tier 1: Core CLI tools
{{- range $name, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 1) (hasKey $pkg "apt") }}
{{-     if not (hasKey $pkg "os") }}
    {{ $pkg.apt }}
{{-     end }}
{{-   end }}
{{- end }}
)

# Packages not available in Debian repos (will be skipped with warning)
SKIPPED_PACKAGES=(
{{- range $name, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 1) (not (hasKey $pkg "apt")) (hasKey $pkg "brew") }}
{{-     if not (hasKey $pkg "os") }}
    {{ $name }}
{{-     end }}
{{-   end }}
{{- end }}
)

{{ if .is_dev -}}
# Tier 2: Development tools
APT_PACKAGES+=(
{{- range $name, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 2) (hasKey $pkg "apt") }}
{{-     if not (hasKey $pkg "os") }}
    {{ $pkg.apt }}
{{-     end }}
{{-   end }}
{{- end }}
)

SKIPPED_PACKAGES+=(
{{- range $name, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 2) (not (hasKey $pkg "apt")) (hasKey $pkg "brew") }}
{{-     if not (hasKey $pkg "os") }}
    {{ $name }}
{{-     end }}
{{-   end }}
{{- end }}
)
{{ end -}}

# =============================================================================
# Update package cache
# =============================================================================
log "Updating apt cache..."
sudo apt-get update

# =============================================================================
# Install available packages
# =============================================================================
log "Installing ${#APT_PACKAGES[@]} packages from apt repositories..."
sudo DEBIAN_FRONTEND=noninteractive apt-get install -y "${APT_PACKAGES[@]}"

# =============================================================================
# Create symlinks for renamed binaries
# =============================================================================
log "Creating symlinks for renamed binaries..."
mkdir -p ~/.local/bin
{{- range $name, $pkg := .packages }}
{{-   if hasKey $pkg "apt_bin" }}

if command -v {{ $pkg.apt_bin }} &>/dev/null && ! command -v {{ $name }} &>/dev/null; then
    ln -sf "$(command -v {{ $pkg.apt_bin }})" ~/.local/bin/{{ $name }}
    log "Created {{ $name }} -> {{ $pkg.apt_bin }} symlink"
fi
{{-   end }}
{{- end }}

# =============================================================================
# Manual install scripts for packages not in repos
# =============================================================================
if [[ ! -d ~/.tmux/plugins/tpm ]]; then
    log "Installing tpm (Tmux Plugin Manager) via git..."
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
fi

{{ end -}}

# =============================================================================
# Warn about skipped packages
# =============================================================================
if [[ ${#SKIPPED_PACKAGES[@]} -gt 0 ]]; then
    warn "The following packages are not available in Debian repositories:"
    for pkg in "${SKIPPED_PACKAGES[@]}"; do
        warn "  - $pkg"
    done
    log ""
    log "To install missing tools, consider:"
    log "  1. Rust toolchain: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh"
    log "  2. cargo install <package>"
    log "  3. Alternative package sources (PPAs, third-party repos)"
fi

log ""
log "Debian package installation complete!"
