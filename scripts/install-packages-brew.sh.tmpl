#!/usr/bin/env bash
# Homebrew package installer — used on macOS, Silverblue, and Debian (when homebrew=true)
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

log "Installing packages via Homebrew..."

{{ if ne .chezmoi.os "darwin" -}}
# Install Homebrew on Linux if needed
bash <(render_template scripts/install-homebrew.sh.tmpl)
{{ end -}}

ensure_brew_in_path
require_cmd brew

brew bundle --file=<(render_template Brewfile.tmpl)

log "Homebrew package installation complete!"
