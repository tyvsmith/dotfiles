#!/usr/bin/env bash
# Arch Linux package installer — generated from .chezmoidata/packages.yaml
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

# Prefer paru, fall back to yay, then pacman (no AUR support)
if command -v paru &>/dev/null; then
    AUR_HELPER="paru"
elif command -v yay &>/dev/null; then
    AUR_HELPER="yay"
else
    AUR_HELPER=""
fi

log "Installing packages via ${AUR_HELPER:-pacman}..."

# =============================================================================
# All packages in a single list — paru handles official + AUR
# =============================================================================
PACKAGES=(
    # Tier 1: Core CLI tools
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $an := default $n (index $pkg "arch_name") }}
{{-   if and (eq (int $pkg.tier) 1) (not (hasKey $pkg "os")) (or (not (hasKey $pkg "arch")) $pkg.arch) }}
    {{ $an }}
{{-   end }}
{{- end }}
)

{{ if .is_dev -}}
# Tier 2: Development tools
PACKAGES+=(
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $an := default $n (index $pkg "arch_name") }}
{{-   if and (eq (int $pkg.tier) 2) (not (hasKey $pkg "os")) (or (not (hasKey $pkg "arch")) $pkg.arch) }}
    {{ $an }}
{{-   end }}
{{- end }}
)
{{ end -}}

{{ if .install_ui_apps -}}
# Tier 3: GUI apps
PACKAGES+=(
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $an := default $n (index $pkg "arch_name") }}
{{-   if and (eq (int $pkg.tier) 3) (or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) "linux")) (or (not (hasKey $pkg "arch")) $pkg.arch) }}
    {{ $an }}
{{-   end }}
{{- end }}
)
{{ end -}}

if [[ -n "$AUR_HELPER" ]]; then
    log "Installing ${#PACKAGES[@]} packages via $AUR_HELPER..."
    $AUR_HELPER -S --needed --noconfirm "${PACKAGES[@]}"
else
    warn "No AUR helper found (paru/yay). Installing official repo packages only."
    warn "To install paru: https://github.com/Morganamilo/paru#installation"
    sudo pacman -S --needed --noconfirm "${PACKAGES[@]}" 2>/dev/null || \
        warn "Some packages failed — likely AUR packages that need paru/yay."
fi

{{ if .install_ui_apps -}}
# =============================================================================
# Flatpak packages (Tier 3 GUI apps)
# =============================================================================
FLATPAK_PACKAGES=(
{{- range $key, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 3) (hasKey $pkg "flatpak") (not (hasKey $pkg "os")) }}
    {{ $pkg.flatpak }}
{{-   end }}
{{- end }}
)

if [[ ${#FLATPAK_PACKAGES[@]} -gt 0 ]]; then
    if command -v flatpak &>/dev/null; then
        log "Installing ${#FLATPAK_PACKAGES[@]} Flatpak apps..."
        for app_id in "${FLATPAK_PACKAGES[@]}"; do
            flatpak install -y --noninteractive flathub "$app_id" 2>/dev/null || \
                warn "Failed to install flatpak: $app_id"
        done
    else
        warn "flatpak not found. Skipping Flatpak apps."
    fi
fi
{{ end -}}

{{ if .is_dev -}}
# AI tools not in repos — provide installation instructions
MISSING_AI=()
command -v llm &>/dev/null      || MISSING_AI+=("llm: pipx install llm")
command -v gemini &>/dev/null    || MISSING_AI+=("gemini-cli: npm install -g @google/generative-ai-cli")
command -v opencode &>/dev/null  || MISSING_AI+=("opencode: see https://github.com/openai/opencode")

if [[ ${#MISSING_AI[@]} -gt 0 ]]; then
    warn "Some AI tools need manual installation:"
    for msg in "${MISSING_AI[@]}"; do
        warn "  $msg"
    done
fi
{{ end -}}

log "Arch package installation complete!"
