#!/usr/bin/env bash
# Arch Linux package installer — generated from .chezmoidata/packages.yaml
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

# Prefer paru, fall back to yay, then pacman (no AUR support)
if command -v paru &>/dev/null; then
    AUR_HELPER="paru"
elif command -v yay &>/dev/null; then
    AUR_HELPER="yay"
else
    AUR_HELPER=""
fi

log "Installing packages via ${AUR_HELPER:-pacman}..."

PACKAGES=(
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $resolved := default $n (index $pkg "arch_name") }}
{{-   if and
        (le (int $pkg.tier) (int $.tier))
        (or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) "linux"))
        (or (not (hasKey $pkg "arch")) $pkg.arch)
}}
    {{ $resolved }}
{{-   end }}
{{- end }}
)

if [[ -n "$AUR_HELPER" ]]; then
    log "Installing ${#PACKAGES[@]} packages via $AUR_HELPER..."
    $AUR_HELPER -S --needed --noconfirm "${PACKAGES[@]}"
else
    warn "No AUR helper found (paru/yay). Installing official repo packages only."
    warn "To install paru: https://github.com/Morganamilo/paru#installation"
    sudo pacman -S --needed --noconfirm "${PACKAGES[@]}" 2>/dev/null || \
        warn "Some packages failed — likely AUR packages that need paru/yay."
fi

{{ if ge (int .tier) 2 -}}
# AI tools not in repos — provide installation instructions
MISSING_AI=()
command -v llm &>/dev/null      || MISSING_AI+=("llm: pipx install llm")
command -v gemini &>/dev/null    || MISSING_AI+=("gemini-cli: npm install -g @google/generative-ai-cli")
command -v opencode &>/dev/null  || MISSING_AI+=("opencode: see https://github.com/openai/opencode")

if [[ ${#MISSING_AI[@]} -gt 0 ]]; then
    warn "Some AI tools need manual installation:"
    for msg in "${MISSING_AI[@]}"; do
        warn "  $msg"
    done
fi
{{ end -}}

log "Arch package installation complete!"
