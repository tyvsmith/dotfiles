#!/usr/bin/env bash
# Flatpak package installer — installs tier 3 GUI apps via Flatpak
#
# On Arch, packages with native AUR support are skipped (installed via paru).
# On all other Linux distros, flatpak is the primary GUI app installer.
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

if ! command -v flatpak &>/dev/null; then
    warn "flatpak not found — skipping Flatpak app installation."
    warn "Install flatpak: https://flatpak.org/setup/"
    exit 0
fi

log "Installing Flatpak apps..."

# Ensure Flathub remote is configured
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true

# =============================================================================
# Tier 3 packages with Flatpak IDs
# On Arch, skip packages with native arch support (paru handles those)
# =============================================================================
FLATPAK_APPS=(
{{- range $key, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 3) (hasKey $pkg "flatpak") }}
{{-     if or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) "linux") }}
{{-       $skipNative := and (eq $.distro "arch") (or (not (hasKey $pkg "arch")) $pkg.arch) }}
{{-       if not $skipNative }}
    {{ $pkg.flatpak }}  # {{ default $key (index $pkg "name") }} — {{ $pkg.desc }}
{{-       end }}
{{-     end }}
{{-   end }}
{{- end }}
)

if [[ ${#FLATPAK_APPS[@]} -eq 0 ]]; then
    log "No Flatpak apps to install."
    exit 0
fi

# =============================================================================
# Install Flatpak apps
# =============================================================================
log "Installing ${#FLATPAK_APPS[@]} Flatpak apps from Flathub..."
INSTALLED=0
FAILED=0

for app_id in "${FLATPAK_APPS[@]}"; do
    if flatpak info "$app_id" &>/dev/null; then
        log "  Already installed: $app_id"
        ((INSTALLED++))
    else
        if flatpak install -y --noninteractive flathub "$app_id"; then
            log "  Installed: $app_id"
            ((INSTALLED++))
        else
            warn "  Failed to install: $app_id"
            ((FAILED++))
        fi
    fi
done

log ""
log "Flatpak installation complete! ($INSTALLED installed, $FAILED failed)"
