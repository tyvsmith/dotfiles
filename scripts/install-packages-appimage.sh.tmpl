#!/usr/bin/env bash
# AppImage installer — downloads packages with appimage fields up to the profile tier
#
# Used on Silverblue/Bazzite where native package managers can't install desktop apps.
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

log "Installing AppImages..."

APPIMAGE_DIR="${HOME}/Applications"
mkdir -p "$APPIMAGE_DIR"

INSTALLED=0
SKIPPED=0
FAILED=0
{{- range $name, $pkg := .packages }}
{{-   if and
        (le (int $pkg.tier) (int $.tier))
        (hasKey $pkg "appimage")
        (or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) "linux"))
}}

# {{ $name }}: {{ $pkg.desc }}
if [[ -f "$APPIMAGE_DIR/{{ $name }}.AppImage" ]]; then
    log "  Already installed: {{ $name }}"
    SKIPPED=$((SKIPPED + 1))
else
    log "  Fetching {{ $name }} from GitHub ({{ $pkg.appimage }})..."
    APPIMAGE_URL=$(curl -sL "https://api.github.com/repos/{{ $pkg.appimage }}/releases/latest" \
        | jq -r '.assets[] | select(.name | test("AppImage$")) | .browser_download_url' \
        | head -1)
    if [[ -n "$APPIMAGE_URL" && "$APPIMAGE_URL" != "null" ]]; then
        curl -sL "$APPIMAGE_URL" -o "$APPIMAGE_DIR/{{ $name }}.AppImage"
        chmod +x "$APPIMAGE_DIR/{{ $name }}.AppImage"
        log "  Installed: {{ $name }}"
        INSTALLED=$((INSTALLED + 1))
    else
        warn "  Failed: {{ $name }} — no AppImage asset found in {{ $pkg.appimage }}"
        FAILED=$((FAILED + 1))
    fi
fi
{{-   end }}
{{- end }}

log ""
log "AppImage installation complete! ($INSTALLED installed, $SKIPPED already present, $FAILED failed)"
