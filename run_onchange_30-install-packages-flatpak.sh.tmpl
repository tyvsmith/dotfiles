#!/usr/bin/env bash
# Chezmoi run_onchange script: Install packages via Flatpak
#
# Cascade order: brew → brew_cask → pacman → apt → dnf → rpm_ostree → flatpak → appimage
# Only includes packages with a flatpak: field that aren't handled by any
# earlier native manager.
#
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# profiles.yaml hash: {{ include ".chezmoidata/profiles.yaml" | sha256sum }}

{{ $p := index .profiles .profile -}}
{{ if not (and (hasKey $p "flatpak") $p.flatpak) -}}
# Profile '{{ .profile }}' does not use Flatpak — nothing to do.
exit 0
{{ else -}}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

if ! command -v flatpak &>/dev/null; then
    warn "flatpak not found — skipping Flatpak app installation."
    warn "Install flatpak: https://flatpak.org/setup/"
    exit 0
fi

log "Using profile '{{ .profile }}' — installing packages via Flatpak"

# Ensure Flathub remote is configured
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true

FLATPAK_APPS=(
{{- range $key, $pkg := .packages }}
{{-   template "cascade-filter" (dict "root" $ "pkg" $pkg "key" $key "manager" "flatpak" "fmt" "    %s  # %s") }}
{{- end }}
)

if [[ ${#FLATPAK_APPS[@]} -eq 0 ]]; then
    log "No Flatpak apps to install (all handled by native package manager)."
    exit 0
fi

log "Installing ${#FLATPAK_APPS[@]} Flatpak apps from Flathub..."
INSTALLED=0
FAILED=0

for app_id in "${FLATPAK_APPS[@]}"; do
    if flatpak info "$app_id" &>/dev/null; then
        log "  Already installed: $app_id"
        INSTALLED=$((INSTALLED + 1))
    else
        if flatpak install -y --noninteractive flathub "$app_id"; then
            log "  Installed: $app_id"
            INSTALLED=$((INSTALLED + 1))
        else
            warn "  Failed to install: $app_id"
            FAILED=$((FAILED + 1))
        fi
    fi
done

log ""
log "Flatpak installation complete! ($INSTALLED installed, $FAILED failed)"
{{ end -}}
