#!/usr/bin/env bash
# Chezmoi run_onchange script: Install packages via dnf (Fedora)
#
# Cascade order: brew → brew_cask → pacman → apt → dnf → rpm_ostree → flatpak → appimage
# Only includes packages not handled by an earlier manager.
# Uses runtime dnf checks to determine availability.
#
# packages.yaml hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
# profiles.yaml hash: {{ include ".chezmoidata/profiles.yaml" | sha256sum }}

{{ $p := index .profiles .profile -}}
{{ if not (and (hasKey $p "dnf") $p.dnf) -}}
# Profile '{{ .profile }}' does not use dnf — nothing to do.
exit 0
{{ else -}}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

log "Using profile '{{ .profile }}' — installing packages via dnf"

declare -A CANDIDATE_PACKAGES=()  # pkg_name -> display_name
{{- range $key, $pkg := .packages }}
{{-   template "cascade-filter" (dict "root" $ "pkg" $pkg "key" $key "manager" "dnf" "fmt" "CANDIDATE_PACKAGES[%s]=\"%s\"") }}
{{- end }}

# =============================================================================
# Check availability and split into installable vs missing
# =============================================================================
DNF_PACKAGES=()
MISSING_PACKAGES=()

for dnf_name in "${!CANDIDATE_PACKAGES[@]}"; do
    if dnf info "$dnf_name" &>/dev/null; then
        DNF_PACKAGES+=("$dnf_name")
    else
        MISSING_PACKAGES+=("${CANDIDATE_PACKAGES[$dnf_name]}")
    fi
done

# Sort for deterministic output
IFS=$'\n' DNF_PACKAGES=($(sort <<<"${DNF_PACKAGES[*]}")); unset IFS
IFS=$'\n' MISSING_PACKAGES=($(sort <<<"${MISSING_PACKAGES[*]}")); unset IFS

# =============================================================================
# Install available packages
# =============================================================================
log "Installing ${#DNF_PACKAGES[@]} packages from dnf repositories..."
if [[ ${#DNF_PACKAGES[@]} -gt 0 ]]; then
    sudo dnf install -y --skip-unavailable "${DNF_PACKAGES[@]}"
fi

# =============================================================================
# Warn about missing packages
# =============================================================================
if [[ ${#MISSING_PACKAGES[@]} -gt 0 ]]; then
    warn "The following packages are not available in your dnf repositories:"
    for pkg in "${MISSING_PACKAGES[@]}"; do
        warn "  - $pkg"
    done
    log ""
    log "To install missing tools, consider:"
    log "  1. COPR repositories: dnf copr enable <repo>"
    log "  2. cargo install <package>"
    log "  3. Homebrew on Linux (re-run with --profile fedora + Homebrew)"
fi

log ""
log "dnf package installation complete!"
{{ end -}}
