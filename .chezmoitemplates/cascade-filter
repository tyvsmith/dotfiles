{{- /*
  cascade-filter: Outputs .line if the package belongs to the specified manager.

  Cascade order: brew → cask → pacman → apt → dnf → flatpak → appimage
  A package goes to the first enabled manager that can handle it.
  Native managers (brew/cask/pacman/apt/dnf) handle a package by default
  unless explicitly excluded (e.g., arch: false). Cask requires cask: true
  and is macOS-only. Flatpak/appimage require their respective field
  (flatpak:/appimage:) to be present.

  Parameters (via dict):
    .root      - root template context ($)
    .pkg       - package data from .packages range
    .manager   - which manager this script handles
    .line      - bash line to output if this package belongs here
*/ -}}
{{- $pkg := .pkg -}}
{{- $mgr := .manager -}}
{{- $p := index .root.profiles .root.profile -}}
{{- $os := .root.chezmoi.os -}}

{{- /* Tier and OS gate */ -}}
{{- $tier_ok := le (int $pkg.tier) (int .root.tier) -}}
{{- $os_ok := or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) "linux") -}}

{{- /* Cask/flatpak/appimage require their field to exist */ -}}
{{- $field_ok := true -}}
{{- if eq $mgr "cask" -}}{{- $field_ok = and (hasKey $pkg "cask") $pkg.cask -}}{{- end -}}
{{- if eq $mgr "flatpak" -}}{{- $field_ok = hasKey $pkg "flatpak" -}}{{- end -}}
{{- if eq $mgr "appimage" -}}{{- $field_ok = hasKey $pkg "appimage" -}}{{- end -}}

{{- /* Compute availability: profile enables manager AND package not excluded */ -}}
{{- $avail_brew := and (and (hasKey $p "brew") $p.brew) (or (not (hasKey $pkg "brew")) $pkg.brew) (not (and (hasKey $pkg "cask") $pkg.cask)) -}}
{{- $avail_cask := and (and (hasKey $p "brew") $p.brew) (eq $os "darwin") (and (hasKey $pkg "cask") $pkg.cask) -}}
{{- $avail_pacman := and (and (hasKey $p "pacman") $p.pacman) (or (not (hasKey $pkg "arch")) $pkg.arch) -}}
{{- $avail_apt := and (and (hasKey $p "apt") $p.apt) (or (not (hasKey $pkg "apt")) $pkg.apt) -}}
{{- $avail_dnf := and (and (hasKey $p "dnf") $p.dnf) (or (not (hasKey $pkg "dnf")) $pkg.dnf) -}}
{{- $avail_flatpak := and (and (hasKey $p "flatpak") $p.flatpak) (hasKey $pkg "flatpak") -}}

{{- /* First enabled manager wins */ -}}
{{- $winner := "none" -}}
{{- if $avail_brew -}}{{- $winner = "brew" -}}
{{- else if $avail_cask -}}{{- $winner = "cask" -}}
{{- else if $avail_pacman -}}{{- $winner = "pacman" -}}
{{- else if $avail_apt -}}{{- $winner = "apt" -}}
{{- else if $avail_dnf -}}{{- $winner = "dnf" -}}
{{- else if $avail_flatpak -}}{{- $winner = "flatpak" -}}
{{- else if (hasKey $pkg "appimage") -}}{{- $winner = "appimage" -}}
{{- end -}}

{{- if and $tier_ok $os_ok $field_ok (eq $winner $mgr) }}
{{ .line }}
{{- end -}}