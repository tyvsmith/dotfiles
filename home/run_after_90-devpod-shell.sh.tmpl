{{- $p := index .profiles .profile -}}
{{- if get $p "devpod" -}}
#!/usr/bin/env bash
# Devpods reset /etc/shells and the login shell on restart, so re-register
# fish on every apply (shared logic: configure_fish_login_shell in common.sh).

set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/../scripts/lib/common.sh"

configure_fish_login_shell
{{ end -}}
