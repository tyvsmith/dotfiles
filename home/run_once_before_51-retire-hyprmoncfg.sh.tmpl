#!/usr/bin/env bash
{{ if ne .de "hyprland-omarchy" -}}
exit 0
{{ else -}}
set -euo pipefail
for unit in punktfunk-wait-local.service hypr-display-session.service hyprmoncfgd.service; do
    if systemctl --user cat "$unit" >/dev/null 2>&1; then
        systemctl --user disable --now "$unit"
    fi
done
{{ end -}}
