#!/usr/bin/env bash
# Chezmoi run_onchange script: Install Homebrew formulas
# Package selection: .chezmoitemplates/cascade-filter
# Only includes formula (non-cask) packages assigned to brew by the cascade.

{{ $p := index .profiles .profile -}}
{{ if not (and (hasKey $p "brew") $p.brew) -}}
# Profile '{{ .profile }}' does not use Homebrew — nothing to do.
exit 0
{{ else -}}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/../scripts/lib/common.sh"

log "Using profile '{{ .profile }}' — installing Homebrew formulas"

# Add brew to PATH (installs Homebrew on Linux if not present)
ensure_brew_in_path
require_cmd brew

# =============================================================================
# Install formulas via brew bundle
# =============================================================================
export HOMEBREW_NO_AUTO_UPDATE=1

{{ $formulas := includeTemplate "cascade-filter" (dict "root" $ "manager" "brew") | fromJson }}
{{- $casks := includeTemplate "cascade-filter" (dict "root" $ "manager" "brew_cask") | fromJson }}
{{- /* Taps come from what actually lands on Homebrew here (formulas) or in
       the cask script that runs next; a tap nothing needs is never added. */}}
{{- $taps := list }}
{{- range concat $formulas $casks }}
{{-   if hasKey .pkg "brew_tap" }}{{ $taps = append $taps .pkg.brew_tap }}{{ end }}
{{- end -}}
BREWFILE_CONTENT=$(cat <<'BREWFILE'
{{- range uniq $taps }}
tap "{{ . }}"
{{- end }}
{{- range $formulas }}
brew "{{ .name }}"  # {{ .display }}
{{- end }}
{{ if eq .chezmoi.os "darwin" -}}
brew "mas"
{{- range includeTemplate "cascade-filter" (dict "root" $ "manager" "mas") | fromJson }}
mas "{{ .pkg.desc }}", id: {{ .name }}
{{- end }}
{{ end -}}
BREWFILE
)

skip_bundle=""
{{- if get $p "devpod" }}

# The linuxbrew cache tarball is built by running this same script, and the
# Brewfile hash it stamps into the prefix rides along. When the stamp matches,
# the restored tree already equals what bundle + cleanup would produce.
BREWFILE_STAMP="$(brew --prefix)/var/dotfiles/brewfile.sha256"
brewfile_sha=$(printf '%s' "$BREWFILE_CONTENT" | sha256sum | cut -d' ' -f1)
if [[ -f "$BREWFILE_STAMP" && "$(cat "$BREWFILE_STAMP")" == "$brewfile_sha" ]]; then
  log "Homebrew already matches this Brewfile; skipping brew bundle"
  skip_bundle=1
fi
{{- end }}

if [[ -z "$skip_bundle" ]]; then
log "Running brew bundle (formulas)..."
# Run brew bundle with retries (fresh Homebrew installs often have linking failures
# on first pass that resolve after an explicit relink)
MAX_RETRIES=3
for attempt in $(seq 1 "$MAX_RETRIES"); do
  if brew bundle --file=- <<<"$BREWFILE_CONTENT"; then
    break
  fi
  if [ "$attempt" -eq "$MAX_RETRIES" ]; then
    log "brew bundle still failing after $MAX_RETRIES attempts"
    exit 1
  fi
   log "Some packages failed (attempt $attempt/$MAX_RETRIES), relinking and retrying..."
   brew list --formula | xargs -r brew link --overwrite 2>/dev/null || true
done

log "Homebrew formula installation complete!"
{{- if get $p "devpod" }}

# Devpod brew is fully managed by this Brewfile, so uninstall anything it no
# longer lists (retagged packages, manual installs). Not safe on a Mac, where
# ad-hoc `brew install`s are expected to survive.
log "Removing formulas no longer in the Brewfile..."
if brew bundle cleanup --force --file=- <<<"$BREWFILE_CONTENT"; then
  mkdir -p "$(dirname "$BREWFILE_STAMP")"
  printf '%s\n' "$brewfile_sha" > "$BREWFILE_STAMP"
else
  log "brew bundle cleanup failed; continuing"
fi
{{- end }}
fi

# =============================================================================
# Disable vendor fish conf.d files we handle ourselves with caching
# (mise uses MISE_FISH_AUTO_ACTIVATE=0 env var; direnv has no disable mechanism)
# =============================================================================
vendor_dir="$(brew --prefix)/share/fish/vendor_conf.d"
for f in direnv.fish; do
    if [ -s "$vendor_dir/$f" ]; then
        log "Emptying vendor conf.d/$f (handled by dotfiles with caching)"
        : > "$vendor_dir/$f"
    fi
done
{{ end -}}