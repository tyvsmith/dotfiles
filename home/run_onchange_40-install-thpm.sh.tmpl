#!/usr/bin/env bash
# Chezmoi run_onchange script: Install/update theme-hook-plugin-manager (THPM).
# THPM delivers the bundled theme-set.d/* hooks (10-tmux, 10-gtk, etc.).
# THPM's install.sh clones the head of $THPM_BRANCH itself, so the pin selects
# the installer and the guard below; bump it to the branch head to update.

{{ if ne .de "hyprland-omarchy" -}}
# Profile '{{ .profile }}' is not omarchy — nothing to do.
exit 0
{{ else -}}
set -euo pipefail

THPM_REPO="https://github.com/OldJobobo/theme-hook-plugin-manager.git"
export THPM_BRANCH="quattro" # install.sh reads it
THPM_COMMIT="7dac327145f66fbfd4e327bfcd36b1656515a3e2"
THPM_VERSION_FILE="$HOME/.local/share/thpm/version"

if [[ -f "$THPM_VERSION_FILE" ]] && grep -qF "commit=$THPM_COMMIT" "$THPM_VERSION_FILE"; then
    exit 0
fi

echo "Installing/updating THPM @ $THPM_COMMIT"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

git clone --quiet --branch "$THPM_BRANCH" "$THPM_REPO" "$tmp"
git -C "$tmp" -c advice.detachedHead=false checkout --quiet "$THPM_COMMIT"

# Feed a fixed number of "n" answers so the installer runs fully
# non-interactively. THPM's install.sh has at most two reads: the
# adw-gtk-theme prompt (read -r -p) and omarchy-show-done's "press any
# key" (read -n 1 inside `gum spin`). `printf` writes a finite stream
# so we avoid SIGPIPE that `yes` would trigger when set -o pipefail is on.
( cd "$tmp" && printf 'n\nn\nn\n' | bash ./install.sh )
{{ end -}}
