#!/usr/bin/env bash
# Chezmoi run_onchange script: Install packages via apt (Debian/Ubuntu)
# Package selection: .chezmoitemplates/cascade-filter
# CANDIDATE_PACKAGES is filled here and read by install_probed (common.sh).
# shellcheck disable=SC2034
# Uses runtime apt-cache checks to determine availability.

{{ $p := index .profiles .profile -}}
{{ if not (and (hasKey $p "apt") $p.apt) -}}
# Profile '{{ .profile }}' does not use apt — nothing to do.
exit 0
{{ else -}}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/../scripts/lib/common.sh"

log "Using profile '{{ .profile }}' — installing packages via apt"

declare -A CANDIDATE_PACKAGES=()  # pkg_name -> display_name
{{- range includeTemplate "cascade-filter" (dict "root" $ "manager" "apt") | fromJson }}
CANDIDATE_PACKAGES[{{ .name }}]="{{ .display }}"
{{- end }}

log "Updating apt cache..."
sudo apt-get update

install_probed "apt-cache show" "sudo DEBIAN_FRONTEND=noninteractive apt-get install -y" \
    "The following packages are not available in your apt repositories:" \
    "Rust toolchain: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh" \
    "cargo install <package>" \
    "Alternative package sources (PPAs, third-party repos)" \
    "Homebrew on Linux: re-init with a brew-enabled profile (e.g. devpod)"

log ""
log "apt package installation complete!"
{{ end -}}
