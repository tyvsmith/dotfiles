{
  "hooks": [
    {
      "on": "pairing.pending",
      "run": "/usr/share/punktfunk/omarchy/hooks/pairing-pending",
      "timeout_s": 30,
      "debounce_ms": 2000
    },
    {
      "on": "stream.started",
      "run": "/usr/share/punktfunk/omarchy/hooks/stream-started",
      "timeout_s": 30,
      "debounce_ms": 0
    },
    {
      "on": "stream.stopped",
      "run": "/usr/share/punktfunk/omarchy/hooks/stream-stopped",
      "timeout_s": 30,
      "debounce_ms": 0
    },
    {
      "on": "stream.started",
      "run": "/usr/share/punktfunk/omarchy/hooks/idle-guard on",
      "timeout_s": 30,
      "debounce_ms": 0
    },
    {
      "on": "stream.stopped",
      "run": "/usr/share/punktfunk/omarchy/hooks/idle-guard off",
      "timeout_s": 30,
      "debounce_ms": 0
    },
    {
      "on": "client.connected",
      "filter": {
        "client": "Ty's Tab S8+"
      },
      "run": "{{ .chezmoi.homeDir }}/.local/bin/punktfunk-restore-audio",
      "timeout_s": 10,
      "debounce_ms": 0
    },
    {
      "on": "stream.started",
      "filter": {
        "client": "Ty's Tab S8+"
      },
      "run": "{{ .chezmoi.homeDir }}/.local/bin/punktfunk-restore-audio",
      "timeout_s": 15,
      "debounce_ms": 0
    }
  ]
}
