# =============================================================================
# PATH & Environment Bootstrap
# =============================================================================()


{{ $p := index .profiles .profile -}}
{{ if and (hasKey $p "brew") $p.brew -}}
# Homebrew
set -l brew_prefix {{ template "brew-prefix" . }}
if test -x $brew_prefix/bin/brew
    __cached_source $brew_prefix/bin/brew shellenv
end
{{ end -}}

{{ if eq .de "hyprland-omarchy" -}}
# Omarchy
set -gx OMARCHY_PATH /usr/share/omarchy
{{ end -}}

# Custom bins (before mise activation, so a mise installed to ~/.local/bin,
# as on devpod-slim, is found)
fish_add_path -a --path ~/.local/bin

# Mise - polyglot runtime version manager (Java, Python, Node, etc.)
# PATH activation (not --shims): a fish_prompt hook runs `mise hook-env`, which
# puts the real tool bin dirs (incl. ~/.cargo/bin) on PATH — so binaries added
# by `cargo install` / `npm i -g` work without a `mise reshim`. hook-env keeps
# entries added after activation (like the overrides move below) in front.
# Not cached: the activate output embeds `set -gx PATH <current PATH>`, so a
# cached copy would replay a stale PATH snapshot into every new shell.
command -q mise; and mise activate fish | source

# Override bins (Should come first on path)
fish_add_path --move --path ~/.local/share/overrides/bin
