{{- $p := index .profiles .profile -}}
# =============================================================================
# Modern CLI Tool Abbreviations
# These EXPAND visibly before running, helping build muscle memory
# Non-core abbreviations are gated by profile tags at template time
# =============================================================================

{{- $tags := $p.tags }}
if status is-interactive
    function __deferred_abbr_init --on-event fish_prompt
    #Delete the function after it runs the first time
    functions --erase __deferred_abbr_init 
        # --- Core: Compatible syntax (flags mostly work the same) ---

        # Bat for cat
        abbr --add cat 'bat -p'

        # trash-cli for rm (safer delete)
        abbr --add rm 'trash-put'

        # Duf for df (beautiful disk free)
        abbr --add df duf

        # Dust for du (visual disk usage)
        abbr --add du dust

        # Ripgrep for grep
        abbr --add grep rg

        # fd for find
        abbr --add find fd

        # sd for sed
        abbr --add sed sd

        # xh for curl
        abbr --add curl xh

        # Editor (force neovim)
        abbr --add vim nvim
        abbr --add vi nvim

        # Chezmoi
        abbr --add cz chezmoi
        abbr --add cza chezmoi apply

        # Lazygit
        abbr --add lg lazygit

        # Rails
        abbr --add r rails

        # Directory navigation
        abbr --add .. 'cd ..'
        abbr --add ... 'cd ../..'
        abbr --add .... 'cd ../../..'

        # Git
        abbr --add g git
        abbr --add gst git status
        abbr --add gco git checkout
        abbr --add gbr git branch
        abbr --add gp git push
        abbr --add gcm 'git commit -m'
        abbr --add gcam 'git commit -a -m'
        abbr --add gcad 'git commit -a --amend'

        {{ if has "dev" $tags -}}
            # --- Dev tools ---
            # Difftastic for diff
            abbr --add diff difft

            # mise upgrade without the release-age hold
            abbr --add mup 'MISE_MINIMUM_RELEASE_AGE=0 mise up'
        {{ end -}}

        {{ if has "dev-extra" $tags -}}
            # Gping for ping (graph visualization)
            abbr --add ping gping

        {{ end -}}

        {{ if has "container" $tags -}}
            # --- Container management ---
            abbr --add d docker
            abbr --add p podman
            abbr --add db distrobox
            abbr --add dbe 'distrobox enter'
            abbr --add dbl 'distrobox list'
            abbr --add dbs 'distrobox stop'
            abbr --add dbrm 'distrobox rm'
            abbr --add dbc 'distrobox create'
        {{ end -}}

        {{ if has "ai" $tags -}}
            # --- AI tools (match omarchy's bash aliases) ---
            abbr --add c 'opencode --auto'
            abbr --add cy 'codex --approve-for-me'
            abbr --add h herdr
            abbr --add ic  'tdl c'
            abbr --add ix  'tdl cx'
            abbr --add icx 'tdl c cx'
            {{ if eq (get $p "de") "hyprland-omarchy" -}}
            abbr --add a 'omarchy-agent --inline'
            {{ end -}}
        {{ end -}}

        {{ if get $p "work" -}}
            # --- DevPod (work) ---
            abbr --add dv devpod
            abbr -a --position anywhere --command devpod rm delete
            abbr -a --position anywhere --command devpod ls ps
            abbr -a --position anywhere --command devpod c create
            abbr -a --position anywhere --command devpod r restart
        {{ end -}}

        {{ if has "experiment" $tags -}}
            # --- Experimental ---
            abbr --add zj zellij
        {{ end -}}

        __abbr_tips_init
    end
end