# =============================================================================
# Environment Variables
# Editor, SDK managers, and other global exports
# =============================================================================

# Editor
{{ if eq .de "hyprland-omarchy" -}}
# omarchy's launcher honors the editor chosen in Omarchy defaults (nvim fallback).
# A list, not a string: fish expands $EDITOR to two words and exports it
# space-joined, so both `$EDITOR file` and tools reading the env work.
set -gx EDITOR omarchy-launch-editor --inline
{{ else -}}
set -gx EDITOR nvim
{{ end -}}
set -gx VISUAL $EDITOR
set -gx SUDO_EDITOR $EDITOR

{{ if eq .de "hyprland-omarchy" -}}
# Terminal programs (gh, etc.) open URLs detached from the terminal process
# tree. Shell-scoped on purpose: exporting BROWSER session-wide makes
# xdg-settings refuse to change the default browser.
set -gx BROWSER omarchy-launch-browser

{{ end -}}
{{ if ne .chezmoi.os "darwin" -}}
# /etc/profile.d/locale.sh only runs for login shells. Shells started by SSH or
# herdr's remote bridge miss it and land in the C locale, where printf emits
# \u escapes literally. Mirror locale.sh for those sessions.
if not set -q LANG; and test -r /etc/locale.conf
    for line in (string match -rv '^\s*(#|$)' </etc/locale.conf)
        set -l kv (string split -m1 = -- $line)
        set -gx $kv[1] (string trim -c '"' -- $kv[2])
    end
end
set -q LANG; or set -gx LANG C.UTF-8

{{ end -}}

# Bat — use ansi theme so terminal colors aren't overridden
set -gx BAT_THEME ansi

# Color man pages with bat
set -gx MANROFFOPT -c
set -gx MANPAGER "sh -c 'col -bx | bat -l man -p'"

# Disable Homebrew vendor conf.d auto-activation — we handle these ourselves
# with caching and interactive guards (see zz_03_interactive.fish)
set -gx MISE_FISH_AUTO_ACTIVATE 0

# Podman — point Docker-compatible tools (lazydocker, etc.) at podman socket
{{ if ne .chezmoi.os "darwin" -}}
set -gx DOCKER_HOST "unix:///run/user/"(id -u)"/podman/podman.sock"
{{ end -}}


# SSH agent — always the stable symlink. The resolver repoints it when the
# target is dead or when this shell inherited a newer live agent (fresh SSH
# login with forwarding). Every process using the symlink follows the
# repoint without an env change, so herdr/tmux panes never go stale.
~/.config/ssh/refresh-auth-sock.sh
set -gx SSH_AUTH_SOCK ~/.ssh/ssh_auth_sock
