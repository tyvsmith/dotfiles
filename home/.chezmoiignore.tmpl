{{- $p := index .profiles .profile -}}
# Plaintext versions of encrypted files are for local editing only, never deployed
**/decrypted_*

# Sample/template files exist as in-repo documentation only, never deployed
**/*.sample

# Python test suites run from the source dir leave bytecode caches behind
**/__pycache__

{{ if not (get $p "decrypt") }}
# Encryption not configured for this profile — skip encrypted files
**/*.age
{{ end }}

{{ if not (get $p "backup") }}
# restic backups only run on personal machines (profile backup: true).
# Skipping the whole config dir keeps the decrypt() in the profile template from
# even running on servers/containers (which lack the age key).
.config/resticprofile
.config/resticprofile/**
{{ end }}

{{ if not (get $p "work") }}
# Work-only: devpod CLI config and the ~/.devpod symlink to it. Gated on work,
# not devpod, to match personal.devpod.yaml.tmpl: the work Mac runs the CLI.
.devpod
.config/devpod
.config/devpod/**
{{ end }}

{{ if not (and (get $p "devpod") (get $p "brew")) }}
# Linuxbrew snapshot restore — only brew-based devpods (devpod-slim uses mise)
.local/bin/devpod-linuxbrew-fetch
{{ end }}

{{ if not (get $p "mise") }}
# mise package lockfile — only profiles that install packages via mise
.config/mise/mise.lock
{{ end }}

{{ if ne .chezmoi.os "darwin" }}
# macOS-only configs — the software does not exist on Linux:
#   skhd    hotkey daemon (+ launch-here.sh, new-ghostty-window.sh)
#   omniwm  Niri-style tiling window manager
#   borders JankyBorders window borders
#   raycast launcher
.config/skhd
.config/omniwm
.config/borders
.config/raycast
{{ end }}

{{ if ne (get $p "de") "hyprland-omarchy" }}
# Hyprland+omarchy ecosystem — skip on non-Hyprland systems
.config/pipewire/
.config/wireplumber/
.config/remote-desktop/
.local/bin/hypr-monitor-scale
.config/systemd/user/remote-desktop-web.service
.config/hypr/
.config/xkb/
.config/quickshell/
.config/hypr-dock/
.config/xdg-desktop-portal/
.config/systemd/user/xdg-desktop-portal-gnome.service.d/
.config/fish/functions/iso2sd.fish
.config/fish/completions/omarchy.fish
.local/share/overrides/bin/omarchy-fetch-webapp-icon
.local/share/overrides/bin/omarchy-launch-webapp
.local/share/overrides/bin/omarchy-webapp-install
.local/share/overrides/bin/omarchy-audio-output-volume
.local/share/overrides/bin/gtk-compat
.local/share/overrides/bin/shelly-ui
.local/share/overrides/bin/pavucontrol
.local/share/applications/com.shellyorg.shelly.desktop
.local/share/themes/OmarchyCompat/
.local/bin/wait-for-sni
.config/omarchy/
.config/pacman/
.config/voxtype/
.config/systemd/user/voxtype.service.d/
.local/bin/voxtype-detect-category
.local/bin/voxtype-smart-toggle
.local/bin/voxtype-cleanup
.local/share/overrides/bin/ydotool
{{ end }}

{{- $tags := $p.tags }}
{{ if not (has "ui" $tags) }}
# GUI terminal/browser configs — nothing to run them on a headless machine
.config/ghostty
.config/ghostty/**
.config/kitty
.config/kitty/**
.local/bin/zen-pwa
{{ end }}

{{ if not (has "hardware" $tags) }}
# DDC monitor control — needs the physical monitor
.local/bin/lg-monitor-input-control
{{ end }}

{{ if not (has "experiment" $tags) }}
.config/zellij
.config/zellij/**
{{ end }}

{{ if not (get $p "pacman") }}
# paru is Arch-only
.local/share/bash-completion/completions/paru.bash
{{ end }}

{{ if not (has "gaming" $tags) }}
# Gaming-only: ScopeBuddy launch layering and GameMode CCD pinning.
# environment.d/gaming.conf is deliberately NOT here -- it only raises the
# NVIDIA shader cache ceiling, which is inert on a machine that never games.
.config/scopebuddy/
.config/scopebuddy/**
.config/gamemode.ini
{{ end }}

{{ if or (ne (get $p "de") "hyprland-omarchy") (not (has "gaming" $tags)) }}
# Punktfunk host integration needs an Omarchy gaming desktop.
.config/punktfunk/
.config/systemd/user/punktfunk-host.service.d/
.local/share/overrides/bin/punktfunk-gamescope
.local/bin/punktfunk-restore-audio

# HELLDIVERS 2 stratagem scanner capture helper. Needs both halves: omasnap is
# omarchy's screenshot tool, and the game it captures only exists where Steam is.
.local/bin/hd2-screenshot
{{ end }}

{{ if not (get $p "work") }}
# Work-only: aifx + claude settings-repair overrides (paths are target-relative)
.local/share/overrides/bin/claude
.local/share/overrides/bin/aifx
{{ end }}
