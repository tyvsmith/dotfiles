{{- /*
  cascade-filter: Outputs a formatted line if the package belongs to the
  specified manager, with the manager-specific package name resolved.

  Cascade order: brew → brew_cask → pacman → apt → dnf → rpm_ostree → flatpak → appimage
  A package goes to the first enabled manager that can handle it.

  Native manager fields are tri-state:
    absent  = available, use YAML key as package name
    string  = available, use string as package name override
    false   = excluded from this manager

  brew_cask is a boolean modifier on brew (default false):
    absent/false = brew formula (or not a brew package)
    true         = brew cask (macOS only); name comes from brew: or YAML key

  rpm_ostree/flatpak/appimage are opt-in: require their field to be present.

  de field is a string match:
    absent  = no restriction (installs on all profiles)
    string  = only on profiles where de matches (e.g., hyprland-omarchy)

  work/decrypt/backup fields are tri-state:
    absent  = no restriction (installs on all profiles)
    true    = only on profiles where work/decrypt/backup is true
    false   = only on profiles where work/decrypt/backup is false

  Parameters (via dict):
    .root      - root template context ($)
    .pkg       - package data from .packages range
    .key       - YAML key (canonical package name)
    .manager   - which manager this script handles
    .fmt       - printf format string; receives (resolved_name, display_name)
*/ -}}
{{- $pkg := .pkg -}}
{{- $key := .key -}}
{{- $mgr := .manager -}}
{{- $p := index .root.profiles .root.profile -}}
{{- $os := .root.chezmoi.os -}}
{{- $display := default $key (index $pkg "name") -}}

{{- /* Enabled, tags, OS, DE, work, and decrypt gates */ -}}
{{- $enabled := not (and (hasKey $pkg "enabled") (not $pkg.enabled)) -}}
{{- $tags_ok := false -}}
{{- $profile_tags := splitList ", " .root.tags -}}
{{- range $pkg.tags -}}
{{-   if has . $profile_tags -}}{{- $tags_ok = true -}}{{- end -}}
{{- end -}}
{{- $os_ok := or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) $os) -}}
{{- $de_ok := or (not (hasKey $pkg "de")) (eq (default "" $pkg.de) .root.de) -}}
{{- $work_ok := or (not (hasKey $pkg "work")) (eq $pkg.work .root.work) -}}
{{- $decrypt_ok := or (not (hasKey $pkg "decrypt")) (eq $pkg.decrypt .root.decrypt) -}}
{{- $backup_ok := or (not (hasKey $pkg "backup")) (eq $pkg.backup .root.backup) -}}

{{- /* Opt-in managers: require their field to exist and be truthy */ -}}
{{- $field_ok := true -}}
{{- if eq $mgr "brew_cask" -}}{{- $field_ok = and (hasKey $pkg "brew_cask") $pkg.brew_cask -}}{{- end -}}
{{- if eq $mgr "rpm_ostree" -}}{{- $field_ok = and (hasKey $pkg "rpm_ostree") $pkg.rpm_ostree -}}{{- end -}}
{{- if eq $mgr "flatpak" -}}{{- $field_ok = and (hasKey $pkg "flatpak") $pkg.flatpak -}}{{- end -}}
{{- if eq $mgr "appimage" -}}{{- $field_ok = and (hasKey $pkg "appimage") $pkg.appimage -}}{{- end -}}

{{- /* Tri-state availability: profile enables manager AND field is not false
     absent = available (default name), string = available (override), false = excluded */ -}}
{{- $avail_brew := and (and (hasKey $p "brew") $p.brew) (or (not (hasKey $pkg "brew")) $pkg.brew) (not (and (hasKey $pkg "brew_cask") $pkg.brew_cask)) -}}
{{- $avail_brew_cask := and (and (hasKey $p "brew") $p.brew) (eq $os "darwin") (and (hasKey $pkg "brew_cask") $pkg.brew_cask) (or (not (hasKey $pkg "brew")) $pkg.brew) -}}
{{- $avail_pacman := and (and (hasKey $p "pacman") $p.pacman) (or (not (hasKey $pkg "pacman")) $pkg.pacman) -}}
{{- $avail_apt := and (and (hasKey $p "apt") $p.apt) (or (not (hasKey $pkg "apt")) $pkg.apt) -}}
{{- $avail_dnf := and (and (hasKey $p "dnf") $p.dnf) (or (not (hasKey $pkg "dnf")) $pkg.dnf) -}}
{{- $avail_rpm_ostree := and (and (hasKey $p "rpm_ostree") $p.rpm_ostree) (and (hasKey $pkg "rpm_ostree") $pkg.rpm_ostree) -}}
{{- $avail_flatpak := and (and (hasKey $p "flatpak") $p.flatpak) (and (hasKey $pkg "flatpak") $pkg.flatpak) -}}
{{- $avail_appimage := and (and (hasKey $p "appimage") $p.appimage) (and (hasKey $pkg "appimage") $pkg.appimage) -}}

{{- /* First enabled manager wins */ -}}
{{- $winner := "none" -}}
{{- if $avail_brew -}}{{- $winner = "brew" -}}
{{- else if $avail_brew_cask -}}{{- $winner = "brew_cask" -}}
{{- else if $avail_pacman -}}{{- $winner = "pacman" -}}
{{- else if $avail_apt -}}{{- $winner = "apt" -}}
{{- else if $avail_dnf -}}{{- $winner = "dnf" -}}
{{- else if $avail_rpm_ostree -}}{{- $winner = "rpm_ostree" -}}
{{- else if $avail_flatpak -}}{{- $winner = "flatpak" -}}
{{- else if $avail_appimage -}}{{- $winner = "appimage" -}}
{{- end -}}

{{- if and $enabled $tags_ok $os_ok $de_ok $work_ok $decrypt_ok $backup_ok $field_ok (eq $winner $mgr) -}}
{{-   $resolved := $display -}}
{{-   if and (eq $mgr "brew") (hasKey $pkg "brew") -}}
{{-     $resolved = index $pkg "brew" -}}
{{-   else if and (eq $mgr "brew_cask") (hasKey $pkg "brew") -}}
{{-     $resolved = index $pkg "brew" -}}
{{-   else if and (eq $mgr "pacman") (hasKey $pkg "pacman") -}}
{{-     $resolved = index $pkg "pacman" -}}
{{-   else if and (eq $mgr "apt") (hasKey $pkg "apt") -}}
{{-     $resolved = index $pkg "apt" -}}
{{-   else if and (eq $mgr "dnf") (hasKey $pkg "dnf") -}}
{{-     $resolved = index $pkg "dnf" -}}
{{-   else if and (eq $mgr "rpm_ostree") (hasKey $pkg "rpm_ostree") -}}
{{-     if ne (printf "%T" (index $pkg "rpm_ostree")) "bool" -}}
{{-       $resolved = index $pkg "rpm_ostree" -}}
{{-     end -}}
{{-   else if eq $mgr "flatpak" -}}
{{-     $resolved = index $pkg "flatpak" -}}
{{-   else if eq $mgr "appimage" -}}
{{-     $resolved = index $pkg "appimage" -}}
{{-   end }}
{{ printf .fmt $resolved $display }}
{{- end -}}
