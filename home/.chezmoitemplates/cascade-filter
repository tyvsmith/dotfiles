{{- /*
  cascade-filter: the packages that land on one manager for the current profile.

  Usage:
    {{ range includeTemplate "cascade-filter" (dict "root" $ "manager" "pacman") | fromJson }}
      {{ .name }}     manager-specific package name (mise spec, cask, flatpak id,
                      appimage repo, mas id)
      {{ .key }}      YAML key
      {{ .display }}  name: override or YAML key
      {{ .pkg }}      the full package entry (brew_tap, mise_opts, desc, ...)
    {{ end }}

  The result round-trips through JSON, so YAML integers in .pkg arrive as
  float64 (mas: 937984704 prints as 9.37984704e+08). Read manager names via
  .name, which is already a string, and pass any numeric .pkg field through
  toString or int before printing it.

  Order: mise → brew → brew_cask → mas → pacman → apt → rpm_ostree → flatpak → appimage
  A package goes to the first manager that the profile enables and the package
  allows. Profile keys gate each manager; brew_cask and mas ride on the profile's
  brew flag and are macOS-only.

  Package gates (all must pass before the cascade runs):
    enabled    absent/true = include, false = skip
    tags       at least one tag shared with the profile
    os         absent = any, else must equal .chezmoi.os
    de         absent = any, else must equal the profile's de
    work/decrypt/backup
               absent = any, true/false = only profiles where the flag matches

  Native managers (brew, pacman, apt) are tri-state:
    absent  = available, use the display name
    string  = available, use the string
    false   = excluded
  brew_cask is a boolean modifier on brew: true = cask (name from brew: or display).
  Opt-in managers (mise, mas, rpm_ostree, flatpak, appimage) need their field
  present and truthy; a string is the name, true means the display name.
*/ -}}
{{- $root := .root -}}
{{- $want := .manager -}}
{{- $p := index $root.profiles $root.profile -}}
{{- $os := $root.chezmoi.os -}}
{{- $de := get $p "de" | default "" -}}
{{- $work := get $p "work" | default false -}}
{{- $decrypt := get $p "decrypt" | default false -}}
{{- $backup := get $p "backup" | default false -}}
{{- $brew_on := get $p "brew" | default false -}}
{{- $order := list "mise" "brew" "brew_cask" "mas" "pacman" "apt" "rpm_ostree" "flatpak" "appimage" -}}
{{- $out := list -}}
{{- range $key, $pkg := $root.packages -}}
{{-   $display := default $key (index $pkg "name") -}}
{{-   $ok := not (and (hasKey $pkg "enabled") (not $pkg.enabled)) -}}
{{-   $tags_ok := false -}}
{{-   range $pkg.tags -}}{{- if has . $p.tags -}}{{- $tags_ok = true -}}{{- end -}}{{- end -}}
{{-   $ok = and $ok $tags_ok -}}
{{-   $ok = and $ok (or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) $os)) -}}
{{-   $ok = and $ok (or (not (hasKey $pkg "de")) (eq (default "" $pkg.de) $de)) -}}
{{-   $ok = and $ok (or (not (hasKey $pkg "work")) (eq $pkg.work $work)) -}}
{{-   $ok = and $ok (or (not (hasKey $pkg "decrypt")) (eq $pkg.decrypt $decrypt)) -}}
{{-   $ok = and $ok (or (not (hasKey $pkg "backup")) (eq $pkg.backup $backup)) -}}
{{-   if $ok -}}
{{-     $winner := "" -}}
{{-     $name := $display -}}
{{-     range $m := $order -}}
{{-       if eq $winner "" -}}
{{-         $field := get $pkg $m -}}
{{-         $has := hasKey $pkg $m -}}
{{-         $cask := and (hasKey $pkg "brew_cask") $pkg.brew_cask -}}
{{-         $avail := false -}}
{{-         if eq $m "brew" -}}
{{-           $avail = and $brew_on (or (not $has) $field) (not $cask) -}}
{{-         else if eq $m "brew_cask" -}}
{{-           $field = get $pkg "brew" -}}
{{-           $has = hasKey $pkg "brew" -}}
{{-           $avail = and $brew_on (eq $os "darwin") $cask (or (not $has) $field) -}}
{{-         else if eq $m "mas" -}}
{{-           $avail = and $brew_on (eq $os "darwin") $has $field -}}
{{-         else if or (eq $m "pacman") (eq $m "apt") -}}
{{-           $avail = and (get $p $m | default false) (or (not $has) $field) -}}
{{-         else -}}
{{-           $avail = and (get $p $m | default false) $has $field -}}
{{-         end -}}
{{-         if $avail -}}
{{-           $winner = $m -}}
{{-           if and $has (ne (printf "%T" $field) "bool") -}}{{- $name = toString $field -}}{{- end -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-     if eq $winner $want -}}
{{-       $out = append $out (dict "name" $name "key" $key "display" $display "pkg" $pkg) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $out | toJson -}}
