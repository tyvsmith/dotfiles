#!/usr/bin/python3
"""Use stock Omarchy scaling except for runtime-only Punktfunk output changes."""
import argparse
import json
import math
import os
import re
import subprocess
import sys


def run(*args):
    return subprocess.check_output(args, text=True, timeout=4).strip()


def next_scale(monitor, direction):
    divisor = math.gcd(monitor['width'] * 120, monitor['height'] * 120)

    def clean(value):
        step = min(round(value * 120), divisor)
        while divisor % step:
            step += 1
        return step / 120

    presets = sorted({v for value in (1, 1.25, 1.6, 2, 3, 4) if (v := clean(value)) <= 4})
    current = monitor['scale']
    if direction == 'up':
        return next((value for value in presets if value > current + .005), current)
    if direction == 'down':
        return next((value for value in reversed(presets) if value < current - .005), current)
    value = float(direction)
    if not math.isfinite(value) or not 1 <= value <= 4:
        raise ValueError('scale must be between 1 and 4')
    result = clean(value)
    if result > 4:
        raise ValueError("no clean scale at or above this value within 1..4")
    return result


def apply_scale(output, value):
    # Punktfunk creates an exact-name rule; Hyprland merges this one-field update.
    reply = run('hyprctl', 'eval', f'hl.monitor({{output={json.dumps(output)},scale={value}}})')
    if reply != 'ok':
        raise RuntimeError(reply)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('direction', help='up, down, or a scale from 1 to 4')
    parser.add_argument('--output', help='explicit PF-* output instead of the focused output')
    args = parser.parse_args()
    monitors = json.loads(run('hyprctl', '-j', 'monitors'))
    selected = [m for m in monitors if not m.get('disabled') and
                (m['name'] == args.output if args.output else m.get('focused'))]
    if len(selected) != 1:
        raise ValueError('expected one active monitor')
    monitor = selected[0]
    if not monitor['name'].startswith('PF-'):
        if args.output:
            raise ValueError('--output is only for Punktfunk screens')
        os.execvp('omarchy', ['omarchy', 'hyprland', 'monitor', 'scaling', args.direction])
    if not re.fullmatch(r'PF-[A-Za-z0-9._-]+', monitor['name']):
        raise ValueError('unsafe output name')
    value = next_scale(monitor, args.direction)
    if abs(value - monitor['scale']) < .005:
        return
    apply_scale(monitor['name'], value)
    print(f"{monitor['name']}: scale {value:.12g} (runtime only)")


if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, RuntimeError, subprocess.SubprocessError) as exc:
        print(f'Monitor scaling: {exc}', file=sys.stderr)
        sys.exit(1)
