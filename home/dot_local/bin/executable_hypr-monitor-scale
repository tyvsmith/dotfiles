#!/usr/bin/python3
"""Step Omarchy's scale presets and save the active hyprmoncfg profile."""
import fcntl
import json
import os
from pathlib import Path
import socket
import subprocess
import sys


def next_scale(direction, output):
    # Reuse the installed implementation without running its live set_scale path.
    source = (Path(os.environ.get('OMARCHY_PATH', '/usr/share/omarchy')) /
              'bin/omarchy-hyprland-monitor-scaling').read_text()
    definitions, marker, _ = source.partition('\ncase "${1:-}" in\n')
    if not marker or 'scale_from_current()' not in definitions:
        raise RuntimeError('Omarchy scaling script changed; integration needs updating')
    command = definitions + '\nrequested=$(scale_from_current "$1" "$2" "$3")\nclean_scale "$requested" "$2" "$3"\n'
    result = subprocess.run(
        ['bash', '-c', command, 'hypr-monitor-scale',
         'next' if direction == 'up' else 'previous',
         str(output['width']), str(output['height'])],
        input=str(output['scale'])+'\n', capture_output=True, text=True, check=True)
    return float(result.stdout)


class Client:
    def __init__(self, sock):
        self.stream = sock.makefile('rwb')
        self.sequence = 0

    def call(self, method, **params):
        self.sequence += 1
        identity = str(self.sequence)
        request = dict(type='request', protocol_version=1, id=identity,
                       method=method, params=params)
        self.stream.write(json.dumps(request).encode()+b'\n')
        self.stream.flush()
        while line := self.stream.readline():
            reply = json.loads(line)
            if reply.get('type') != 'response' or reply.get('id') != identity:
                continue
            if reply.get('error'):
                raise RuntimeError(reply['error']['message'])
            return reply.get('result')
        raise RuntimeError('hyprmoncfg daemon disconnected')


def change(client, direction):
    state = client.call('editor_state')
    focused = [display for display in state['displays'] if display['focused']]
    if len(focused) != 1:
        raise RuntimeError('no unique focused monitor')
    key = focused[0]['key']
    live = next(output for output in state['profile']['outputs'] if output['key'] == key)
    scale = next_scale(direction, live)
    if abs(scale-live['scale']) < 0.00001:
        return
    # An exact source preserves preferred modes and settings not visible in live state.
    status = client.call('status')
    name = status.get('daemon', {}).get('profile_override') or state.get('source_profile')
    profile = next((p for p in state['profiles'] if p['name'] == name), None)
    if profile is None:
        raise RuntimeError('select a saved hyprmoncfg profile before changing scale; temporary stream layouts are left untouched')
    edited = client.call('edit_profile', profile=profile,
                         edit=dict(output_key=key, scale=scale))['profile']
    fresh = client.call('editor_state')
    if fresh.get('monitor_set_hash') != state.get('monitor_set_hash') or fresh['profile']['outputs'] != state['profile']['outputs']:
        raise RuntimeError('display configuration changed; try again')
    transaction = client.call('preview', profile=edited, save_on_commit=True)
    try:
        client.call('commit', transaction_id=transaction['id'], save=True)
    except Exception:
        client.call('revert', transaction_id=transaction['id'])
        raise
    print(f'{name}: scale {scale:g}')


def main():
    if sys.argv[1:] not in (['up'], ['down']):
        raise RuntimeError('usage: hypr-monitor-scale up|down')
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    instance = os.environ['HYPRLAND_INSTANCE_SIGNATURE']
    if not instance or any(c not in 'abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-' for c in instance):
        raise RuntimeError('invalid compositor identity')
    state = runtime / ('hypr-display-session-'+instance)
    state.mkdir(mode=0o700, exist_ok=True)
    # Serialize against game/stream transitions as well as repeated shortcut presses.
    with (state/'lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        with socket.socket(socket.AF_UNIX) as sock:
            sock.settimeout(30)
            sock.connect(str(runtime/'hyprmoncfgd.sock'))
            change(Client(sock), sys.argv[1])


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, KeyError, StopIteration, RuntimeError, subprocess.SubprocessError) as error:
        print(f'hypr-monitor-scale: {error}', file=sys.stderr)
        sys.exit(1)
