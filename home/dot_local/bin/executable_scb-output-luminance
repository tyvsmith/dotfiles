#!/usr/bin/python3
"""Read one output's advertised HDR luminance using wayland-info 1.3+."""
import json
import re
import subprocess
import sys


def parse(text, output):
    ids, color = [], ''
    for block in re.split(r'(?=^interface: )', text, flags=re.M):
        header = re.match(r"interface: 'wl_output',\s+version:\s+\d+, name:\s+(\d+)\n", block)
        if header and f'\tname: {output}\n' in block:
            ids.append(header[1])
        elif block.startswith("interface: 'wp_color_manager_v1',"):
            color = block
    if len(ids) != 1:
        raise RuntimeError(f'output not found or ambiguous: {output}')

    for block in re.split(r'(?=^\toutput: )', color, flags=re.M):
        if not block.startswith(f'\toutput: {ids[0]}\n'):
            continue
        if not re.search(r'^\t\timage description id: \d+$', block, re.M):
            raise RuntimeError(f'color description unavailable: {output}')
        result = dict(output=output, max_luminance=None, reference_luminance=None)
        if re.search(r'^\t\ticc file: size \d+$', block, re.M):
            return result  # An ICC description has no parametric luminance event.
        values = re.search(r'^\t\tluminances \(cd/m²\): min [\d.]+ max (\d+) reference (\d+)$', block, re.M)
        if not values:
            raise RuntimeError(f'unrecognized luminance data: {output}')
        result.update(max_luminance=int(values[1]), reference_luminance=int(values[2]))
        return result
    raise RuntimeError(f'color management output unavailable: {output}')


def query(output):
    text = subprocess.check_output(['wayland-info'], text=True, timeout=2)
    return parse(text, output)


if __name__ == '__main__':
    try:
        if len(sys.argv) != 2:
            raise ValueError('usage: scb-output-luminance OUTPUT')
        print(json.dumps(query(sys.argv[1])))
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as exc:
        print(f'scb-output-luminance: {exc}', file=sys.stderr)
        sys.exit(1)
