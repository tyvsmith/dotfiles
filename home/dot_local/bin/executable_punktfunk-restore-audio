#!/usr/bin/env bash
# Restore desktop audio once after the selected device connects.
set -euo pipefail

state=${XDG_RUNTIME_DIR:?}/punktfunk
mkdir -p "$state"
umask 077
exec >>"$state/audio-hook.log" 2>&1
log() { printf '%s %s\n' "$(date --iso-8601=ns)" "$*"; }
trap 'log "exit=$? event=${PF_EVENT_KIND:-missing}"' EXIT
snapshot=$state/audio-before-connect.json
case ${PF_EVENT_KIND:-} in
    client.connected)
        [[ -n ${PF_EVENT_CLIENT_FINGERPRINT:-} && -n ${PF_EVENT_TS_MS:-} ]] || { log 'skipped: incomplete event'; exit 0; }
        sink=$(pactl get-default-sink)
        source=$(pactl get-default-source)
        temporary=$(mktemp "$snapshot.XXXXXX")
        jq -n --arg fingerprint "$PF_EVENT_CLIENT_FINGERPRINT" --argjson event_ms "$PF_EVENT_TS_MS" \
            --arg sink "$sink" --arg source "$source" \
            '{fingerprint: $fingerprint, event_ms: $event_ms, sink: $sink, source: $source}' > "$temporary"
        mv "$temporary" "$snapshot"
        log "captured sink=$sink source=$source event_ms=$PF_EVENT_TS_MS"
        exit 0
        ;;
    stream.started)
        [[ -n ${PF_EVENT_STREAM_FINGERPRINT:-} && -n ${PF_EVENT_TS_MS:-} ]] || { log 'skipped: incomplete event'; exit 0; }
        ;;
    *) exit 0 ;;
esac
exec 9>"$state/audio-restore.lock"
flock -n 9 || exit 0
fingerprint=$PF_EVENT_STREAM_FINGERPRINT
log "restore started event_ms=$PF_EVENT_TS_MS client=${fingerprint:0:12}"
stream_session() {
    timeout 2 punktfunk-host ctl status --json | jq -er --arg client "${fingerprint:0:12}" '
        .data | if .active_sessions == 0 then "pending"
        elif .active_sessions == 1 and (.sessions | length) == 1 and .sessions[0].client == $client
        then .sessions[0].id | tostring else empty end'
}

session_id=
pending=(sink source)
# Audio capture starts asynchronously; wait briefly for each default claim.
for ((attempt = 0; attempt < 30; attempt++)); do
    session=$(stream_session) || { log 'skipped: different or overlapping session'; exit 0; }
    if [[ $session == pending && -z $session_id ]]; then
        sleep 0.1
        continue
    fi
    session_id=${session_id:-$session}
    [[ $session == "$session_id" ]] || exit 0
    # Connection and stream hooks run asynchronously. Accept only a recent capture for this device.
    capture=$(jq -ce --arg fp "$fingerprint" --argjson ts "$PF_EVENT_TS_MS" \
        'select(.fingerprint == $fp and .event_ms <= $ts and .event_ms >= ($ts - 5000))' \
        "$snapshot" 2>/dev/null) || { sleep 0.1; continue; }
    remaining=()
    for kind in "${pending[@]}"; do
        current=$(pactl "get-default-$kind")
        if [[ $current != punktfunk-* ]]; then
            remaining+=("$kind")
            continue
        fi
        saved=$(jq -er --arg kind "$kind" '.[$kind] | select(type == "string" and length > 0)' <<< "$capture") || continue
        if [[ $saved == punktfunk-* ]]; then
            log "skipped $kind: capture already contained $saved (takeover preceded capture)"
            continue
        fi
        if ! pactl -f json list "${kind}s" | jq -e --arg name "$saved" 'any(.[]; .name == $name)' >/dev/null; then
            log "skipped $kind: captured device $saved is unavailable"
            continue
        fi
        # Recheck before writing: a new stream or manual selection wins.
        [[ $(stream_session) == "$session_id" ]] || exit 0
        [[ $(pactl "get-default-$kind") == "$current" ]] || continue
        pactl "set-default-$kind" "$saved"
        log "restored $kind: $current -> $saved"
    done
    pending=("${remaining[@]}")
    if ((${#pending[@]} == 0)); then
        mv "$snapshot" "$state/audio-restored.json"
        exit 0
    fi
    sleep 0.1
done
log "finished waiting; no further changes (missing capture, unclaimed default, or manual selection)"
