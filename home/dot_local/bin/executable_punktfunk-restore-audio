#!/usr/bin/env bash
# Capture on connection, then restore once the selected stream claims audio.
set -euo pipefail

log() { printf '%s %s\n' "$(date --iso-8601=ns)" "$*"; }

previous_microphone() {
    # Host-owned pre-claim configured preference; automatic selection may have no record.
    local saved_file modified age name
    saved_file=${XDG_STATE_HOME:-$HOME/.local/state}/punktfunk/default-audio-source.json
    modified=$(stat -c %y "$saved_file" 2>/dev/null) || return 1
    modified=$(date -d "$modified" +%s%3N) || return 1
    age=$((PF_EVENT_TS_MS - modified))
    ((age >= 0 && age <= 5000)) || return 1
    name=$(jq -er '.name | select(type == "string" and length > 0) |
        select(startswith("punktfunk-") | not)' "$saved_file") || return 1
    pactl -f json list sources | jq -e --arg name "$name" 'any(.[]; .name == $name)' >/dev/null || return 1
    printf '%s\n' "$name"
}

# The connection hook is asynchronous; the mic may already have switched.
capture_defaults() {
    local sink source previous temporary
    sink=$(pactl get-default-sink)
    source=$(pactl get-default-source)
    if [[ $source == punktfunk-* ]] && previous=$(previous_microphone); then
        source=$previous
        log "recovered source from Punktfunk's recent pre-claim record: $source"
    fi
    temporary=$(mktemp "$snapshot.XXXXXX")
    jq -n --arg fingerprint "$fingerprint" --argjson event_ms "$PF_EVENT_TS_MS" \
        --arg sink "$sink" --arg source "$source" \
        '{fingerprint: $fingerprint, event_ms: $event_ms, sink: $sink, source: $source}' > "$temporary"
    mv "$temporary" "$snapshot"
    log "captured sink=$sink source=$source event_ms=$PF_EVENT_TS_MS"
}

matching_session() {
    timeout 2 punktfunk-host ctl status --json | jq -er --arg client "${fingerprint:0:12}" '
        .data | if .active_sessions == 0 then "pending"
        elif .active_sessions == 1 and (.sessions | length) == 1 and .sessions[0].client == $client
        then .sessions[0].id | tostring else empty end'
}

read_snapshot() {
    # Hooks run asynchronously. Only accept this device's recent connection.
    jq -ce --arg fp "$fingerprint" --argjson ts "$PF_EVENT_TS_MS" \
        'select(.fingerprint == $fp and .event_ms <= $ts and .event_ms >= ($ts - 5000))' \
        "$snapshot" 2>/dev/null
}

restore_defaults() {
    exec 9>"$state/audio-restore.lock"
    flock -n 9 || return 0
    log "restore started event_ms=$PF_EVENT_TS_MS client=${fingerprint:0:12}"
    local session_id='' session capture current saved kind attempt
    local -a pending=(sink source) remaining
    # Audio capture starts asynchronously; wait briefly for each default claim.
    for ((attempt = 0; attempt < 30; attempt++)); do
        session=$(matching_session) || { log 'skipped: different or overlapping session'; return 0; }
        if [[ $session == pending && -z $session_id ]]; then
            sleep 0.1
            continue
        fi
        session_id=${session_id:-$session}
        [[ $session == "$session_id" ]] || return 0
        capture=$(read_snapshot) || { sleep 0.1; continue; }
        remaining=()
        for kind in "${pending[@]}"; do
            current=$(pactl "get-default-$kind")
            if [[ $current != punktfunk-* ]]; then
                remaining+=("$kind")
                continue
            fi
            saved=$(jq -er --arg kind "$kind" '.[$kind] | select(type == "string" and length > 0)' <<< "$capture") || continue
            if [[ $saved == punktfunk-* ]]; then
                log "skipped $kind: capture already contained $saved (takeover preceded capture)"
                continue
            fi
            if ! pactl -f json list "${kind}s" | jq -e --arg name "$saved" 'any(.[]; .name == $name)' >/dev/null; then
                log "skipped $kind: captured device $saved is unavailable"
                continue
            fi
            # Recheck before writing: a new stream or manual selection wins.
            [[ $(matching_session) == "$session_id" ]] || return 0
            [[ $(pactl "get-default-$kind") == "$current" ]] || continue
            pactl "set-default-$kind" "$saved"
            log "restored $kind: $current -> $saved"
        done
        pending=("${remaining[@]}")
        if ((${#pending[@]} == 0)); then
            mv "$snapshot" "$state/audio-restored.json"
            return 0
        fi
        sleep 0.1
    done
    log "finished waiting; no further changes (missing capture, unclaimed default, or manual selection)"
}

main() {
    # Shared invocation context for capture and restore helpers.
    state=${XDG_RUNTIME_DIR:?}/punktfunk
    snapshot=$state/audio-before-connect.json
    mkdir -p "$state"
    umask 077
    exec >>"$state/audio-hook.log" 2>&1
    trap 'log "exit=$? event=${PF_EVENT_KIND:-missing}"' EXIT

    case ${PF_EVENT_KIND:-} in
        client.connected) fingerprint=${PF_EVENT_CLIENT_FINGERPRINT:-} ;;
        stream.started) fingerprint=${PF_EVENT_STREAM_FINGERPRINT:-} ;;
        *) return 0 ;;
    esac
    if [[ -z $fingerprint || -z ${PF_EVENT_TS_MS:-} ]]; then
        log 'skipped: incomplete event'
        return 0
    fi
    case $PF_EVENT_KIND in
        client.connected) capture_defaults ;;
        stream.started) restore_defaults ;;
    esac
}

main
