#!/usr/bin/env bash
# Add the outer HUD while retaining Punktfunk's patched capture implementation.
set -euo pipefail
# Bypass this PATH override when launching the packaged binary.
backend=/usr/bin/punktfunk-gamescope

has_mangoapp=0
for arg in "$@"; do
    case $arg in
        --) break ;;
        --help|--version) exec "$backend" "$@" ;;
        --mangoapp) has_mangoapp=1 ;;
    esac
done

unset MANGOHUD_FPS_LIMIT
export MANGOHUD=0
# Steam mode otherwise substitutes a temporary no_display config.
export MANGOHUD_CONFIGFILE=${MANGOHUD_CONFIGFILE:-${XDG_CONFIG_HOME:-$HOME/.config}/MangoHud/MangoHud.conf}
export MANGOHUD_CONFIG="read_cfg,${MANGOHUD_CONFIG:+$MANGOHUD_CONFIG,}no_display,toggle_hud=Shift_R+F12,fps_limit=0"
if (( ! has_mangoapp )); then
    set -- --mangoapp "$@"
fi
exec "$backend" "$@"
