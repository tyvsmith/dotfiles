#!/usr/bin/env bash
# Chezmoi run_onchange script: Install Homebrew casks (macOS only)
# Package selection: .chezmoitemplates/cascade-filter
# Cask packages on non-macOS cascade to the next available manager.

{{ $p := index .profiles .profile -}}
{{ if not (and (and (hasKey $p "brew") $p.brew) (eq .chezmoi.os "darwin")) -}}
# Profile '{{ .profile }}' does not use Homebrew casks — nothing to do.
exit 0
{{ else -}}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/../scripts/lib/common.sh"

log "Using profile '{{ .profile }}' — installing Homebrew casks"

ensure_brew_in_path
require_cmd brew

# =============================================================================
# Install casks via brew bundle
# =============================================================================
log "Running brew bundle (casks)..."
export HOMEBREW_NO_AUTO_UPDATE=1
brew bundle --file=/dev/stdin <<'BREWFILE'
{{- range $key, $pkg := .packages }}
{{-   template "cascade-filter" (dict "root" $ "pkg" $pkg "key" $key "manager" "brew_cask" "fmt" "cask \"%s\"  # %s") }}
{{- end }}
BREWFILE

log "Homebrew cask installation complete!"
{{ end -}}