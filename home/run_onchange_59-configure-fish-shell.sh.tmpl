#!/usr/bin/env bash
# Configure fish as login shell after package managers install it.
# Runs once per content change; the devpod-only run_after_90 re-runs the same
# step on every apply. Both call configure_fish_login_shell in common.sh.

set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/../scripts/lib/common.sh"

configure_fish_login_shell
