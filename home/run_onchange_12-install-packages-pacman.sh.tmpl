#!/usr/bin/env bash
# Chezmoi run_onchange script: Install packages via pacman/paru (Arch Linux)
# Package selection: .chezmoitemplates/cascade-filter
# CANDIDATE_PACKAGES is filled here and read by install_probed (common.sh).
# shellcheck disable=SC2034

{{ $p := index .profiles .profile -}}
{{ if not (and (hasKey $p "pacman") $p.pacman) -}}
# Profile '{{ .profile }}' does not use pacman — nothing to do.
exit 0
{{ else -}}
set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/../scripts/lib/common.sh"

log "Using profile '{{ .profile }}' — installing packages via pacman/paru"

ensure_pkg paru paru-bin

declare -A CANDIDATE_PACKAGES=()  # pkg_name -> display_name
{{- range includeTemplate "cascade-filter" (dict "root" $ "manager" "pacman") | fromJson }}
CANDIDATE_PACKAGES[{{ .name }}]="{{ .display }}"
{{- end }}

install_probed "paru -Si" "paru -S --needed --noconfirm" \
    "The following packages are not available in official repos or AUR:" \
    "pipx install <package> (for Python tools)" \
    "cargo install <package>" \
    "npm install -g <package>"

log ""
log "Arch package installation complete!"
{{ end -}}
