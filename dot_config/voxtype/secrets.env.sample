# Example secrets file for voxtype-cleanup's LLM post-processor.
#
# Copy this file to ~/.config/voxtype/secrets.env and fill in your own values.
# On machines with chezmoi `decrypt: true` (see .chezmoidata/profiles.yaml),
# the real secrets.env is sourced from encrypted_secrets.env.age automatically;
# this example exists for everyone else.
#
# voxtype-cleanup reads these at the top of its run:
#   - If any required value is missing, the script passes the raw transcript
#     through unchanged (graceful no-op, no error).
#   - Pre-existing environment variables win over the file, so you can
#     override per-shell without editing.

# Required — any OpenAI-compatible /chat/completions endpoint.
# Examples:
#   https://openrouter.ai/api/v1     (multi-provider routing)
#   https://api.openai.com/v1        (OpenAI direct)
#   https://api.groq.com/openai/v1   (Groq direct)
#   http://localhost:11434/v1        (Ollama)
#   http://localhost:1234/v1         (LM Studio)
VOXTYPE_LLM_BASE_URL=https://openrouter.ai/api/v1

# Required — bearer token for the endpoint above.
# Use a dummy value (e.g. `local`) for endpoints that don't authenticate.
VOXTYPE_LLM_API_KEY=sk-your-key-here

# Required — model identifier passed verbatim in the request body.
# Recommended baseline for dictation cleanup (small, fast, follows
# "preserve unknown words" instructions reliably):
VOXTYPE_LLM_MODEL=anthropic/claude-haiku-4.5
#
# Other tested options:
#   meta-llama/llama-3.3-70b-instruct   # cheap, slightly sparser output
#   google/gemini-2.5-flash             # cheap, more opinionated formatting
#   meta-llama/llama-3.1-8b-instruct    # too small — autocorrects unknown words

# Optional — JSON merged into the request body (jq `*` recursive merge).
# Use it to pass provider-specific knobs. Invalid JSON is silently ignored.
#
# OpenRouter — pin routing to a specific upstream backend:
# VOXTYPE_LLM_EXTRA_BODY={"provider":{"order":["Groq"]}}
#
# Note: provider pins only apply to models that backend actually serves.
# Claude models are only available through Anthropic's own backend, so leave
# this unset (or commented) when using anthropic/* models.
