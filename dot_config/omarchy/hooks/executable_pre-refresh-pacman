#!/bin/bash
# Called by patched omarchy-refresh-pacman AFTER it copies the channel template
# into /etc/pacman.conf and BEFORE it runs `sudo pacman -Syyuu`.
#
# Idempotently re-adds user-managed repository Includes so the upgrade
# resolves against the correct repos. Runs as the invoking user with a
# warm sudo cache (refresh-pacman just used sudo).
#
# Two precedence buckets:
#   PRE_CORE — Includes inserted ABOVE [core] (higher priority than Arch)
#   POST     — Includes appended at the END of pacman.conf (lower priority)
set -e

CONF=/etc/pacman.conf

PRE_CORE=(
  /etc/pacman.d/cachyos-repos.conf   # CachyOS znver4 optimized builds
)

POST=(
  /etc/pacman.d/warpdotdev-repo.conf  # Warp terminal updates
)

for snippet in "${PRE_CORE[@]}"; do
  marker="Include = $snippet"
  [[ -r "$snippet" ]] || continue
  grep -qxF "$marker" "$CONF" && continue
  echo "pre-refresh-pacman: inserting $marker above [core]"
  sudo sed -i "0,/^\[core\]/s||$marker\n\n[core]|" "$CONF"
done

for snippet in "${POST[@]}"; do
  marker="Include = $snippet"
  [[ -r "$snippet" ]] || continue
  grep -qxF "$marker" "$CONF" && continue
  echo "pre-refresh-pacman: appending $marker"
  printf '\n%s\n' "$marker" | sudo tee -a "$CONF" >/dev/null
done
