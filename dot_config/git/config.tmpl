[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	default = current
	autoSetupRemote = true
[color]
	ui = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[alias]
	aa = add --all
	ap = add --patch
	br = branch
	ci = commit
	co = checkout
	pf = push --force-with-lease
	st = status
	unstage = reset HEAD --
	last = log -1 HEAD
	remote-branches = for-each-ref --sort=-committerdate --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/remotes
	brs = ! git for-each-ref --sort='authordate:iso8601' --format=\"%(color:blue)%(authordate:relative)\t%(color:red)%(authorname)\t%(color:white)%(color:bold)%(refname:short)\" refs/heads | fzf --tac --bind 'enter:execute(echo {} | rev | cut -f1 | rev | xargs git checkout)+abort,tab:execute-silent(echo {} | rev | cut -f1 | rev | {{ template "copy-cmd" . }})+abort'
	d = ! git status -s | fzf --no-sort --reverse --preview 'git diff --color=always {+2}' --bind=ctrl-j:preview-down --bind=ctrl-k:preview-up --preview-window=right:60%:wrap
[core]
	excludesfile = ~/.config/git/ignore
	autocrlf = input
	untrackedCache = true
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
[commit]
	verbose = true
[merge]
	ff = only
	conflictstyle = diff3
[diff]
	algorithm = histogram
	colorMoved = default
	mnemonicPrefix = true
[fetch]
	prune = true
[rebase]
	autosquash = true
[rerere]
	enabled = true
	autoupdate = true
[url "git@github.com:"]
	followRedirects = true
{{ if not .work -}}
[include]
	path = ~/.config/git/conf.d/oss
{{ end -}}
[include]
	path = ~/.gitconfig.local
[include]
	path = ~/.config/git/local
