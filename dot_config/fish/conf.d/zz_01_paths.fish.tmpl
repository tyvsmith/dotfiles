# =============================================================================
# PATH & Environment Bootstrap
# =============================================================================

# SSH agent — inside tmux, use a stable symlink updated by tmux's
# client-attached hook (see tmux-custom.conf). Outside tmux, use the
# platform default (launchctl on macOS, inherited env on Linux).
if set -q TMUX
    set -gx SSH_AUTH_SOCK ~/.ssh/ssh_auth_sock
{{ if eq .chezmoi.os "darwin" -}}
else
    set -gx SSH_AUTH_SOCK (launchctl getenv SSH_AUTH_SOCK)
{{ end -}}
end

{{ $p := index .profiles .profile -}}
{{ if and (hasKey $p "brew") $p.brew -}}
# Homebrew
set -l brew_prefix {{ template "brew-prefix" . }}
if test -x $brew_prefix/bin/brew
    __cached_source $brew_prefix/bin/brew shellenv
end
{{ end -}}

# Custom bins
fish_add_path --path ~/.local/bin
