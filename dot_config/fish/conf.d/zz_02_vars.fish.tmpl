# =============================================================================
# Environment Variables
# Editor, SDK managers, and other global exports
# =============================================================================

# Editor
set -gx EDITOR nvim
set -gx VISUAL $EDITOR
set -gx SUDO_EDITOR $EDITOR

# Bat — use ansi theme so terminal colors aren't overridden
set -gx BAT_THEME ansi

# Color man pages with bat
set -gx MANROFFOPT -c
set -gx MANPAGER "sh -c 'col -bx | bat -l man -p'"

# Disable Homebrew vendor conf.d auto-activation — we handle these ourselves
# with caching and interactive guards (see zz_03_interactive.fish, zz_06_direnv.fish)
set -gx MISE_FISH_AUTO_ACTIVATE 0

# Podman — point Docker-compatible tools (lazydocker, etc.) at podman socket
{{ if ne .chezmoi.os "darwin" -}}
set -gx DOCKER_HOST "unix:///run/user/"(id -u)"/podman/podman.sock"
{{ end -}}


# SSH agent — inside tmux, use a stable symlink maintained by tmux's
# client-attached hook (see tmux-custom.conf). The hook only fires on
# attach/new-session, so self-heal here for the in-between cases: first
# attach raced launchd, target socket died (sleep/wake, launchd restart),
# symlink got removed. test -S follows the symlink and verifies the
# target is a live socket, so it covers both "missing" and "dangling".
# Outside tmux, use the platform default.
if set -q TMUX
    if not test -S ~/.ssh/ssh_auth_sock
        ~/.config/tmux/scripts/refresh-ssh-sock.sh
    end
    set -gx SSH_AUTH_SOCK ~/.ssh/ssh_auth_sock
{{ if eq .chezmoi.os "darwin" -}}
else
    set -gx SSH_AUTH_SOCK (launchctl getenv SSH_AUTH_SOCK)
{{ end -}}
end