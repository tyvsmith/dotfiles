# =============================================================================
# Environment Variables
# Editor, SDK managers, and other global exports
# =============================================================================

# Editor
set -gx EDITOR nvim
set -gx VISUAL $EDITOR
set -gx SUDO_EDITOR $EDITOR

# Bat — use ansi theme so terminal colors aren't overridden
set -gx BAT_THEME ansi

# fish-async-prompt — async both prompts
set -g async_prompt_functions fish_prompt fish_right_prompt

# Disable Homebrew vendor conf.d auto-activation — we handle these ourselves
# with caching and interactive guards (see zz_03_interactive.fish, zz_06_direnv.fish)
set -gx MISE_FISH_AUTO_ACTIVATE 0

# Podman — point Docker-compatible tools (lazydocker, etc.) at podman socket
{{ if ne .chezmoi.os "darwin" -}}
set -gx DOCKER_HOST "unix:///run/user/"(id -u)"/podman/podman.sock"
{{ end -}}


# SSH agent — inside tmux, use a stable symlink updated by tmux's
# client-attached hook (see tmux-custom.conf). Outside tmux, use the
# platform default (launchctl on macOS, inherited env on Linux).
if set -q TMUX
    set -gx SSH_AUTH_SOCK ~/.ssh/ssh_auth_sock
{{ if eq .chezmoi.os "darwin" -}}
else
    set -gx SSH_AUTH_SOCK (launchctl getenv SSH_AUTH_SOCK)
{{ end -}}
end