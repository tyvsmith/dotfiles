# =============================================================================
# Environment Variables
# Editor, SDK managers, and other global exports
# =============================================================================

# Editor
set -gx EDITOR nvim
set -gx VISUAL $EDITOR
set -gx SUDO_EDITOR $EDITOR

# Bat — use ansi theme so terminal colors aren't overridden
set -gx BAT_THEME ansi

{{ if eq .de "hyprland-omarchy" -}}
# Omarchy
set -gx OMARCHY_PATH $HOME/.local/share/omarchy
fish_add_path --path $OMARCHY_PATH/bin
{{ end -}}

# Podman — point Docker-compatible tools (lazydocker, etc.) at podman socket
{{ if ne .chezmoi.os "darwin" -}}
set -gx DOCKER_HOST "unix:///run/user/"(id -u)"/podman/podman.sock"
{{ end -}}

# Mise — polyglot runtime version manager (Java, Python, Node, etc.)
if command -q mise
    mise activate fish | source
end

# Clean up any duplicate PATH entries from replayed shell configs
dedup_path