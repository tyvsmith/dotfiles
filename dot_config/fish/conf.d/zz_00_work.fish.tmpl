{{- if .work }}
# =============================================================================
# Work machine configuration
# =============================================================================

{{- if eq .chezmoi.os "darwin" }}
# =============================================================================
# Mac
# =============================================================================

# Corporate-provisioned shell configs (managed by Chef/IT)
# Cached via file content hash — no bash subprocess on subsequent shells
__cached_replay cpe "source /etc/zsh/cpe 2>/dev/null"
__cached_replay lda "source ~/.profile_lda 2>/dev/null"

# Skip devpod-sshwrapper.sh pre-flight checks (ussh cert refresh + devpod wait API call)
# Saves ~1.5s on cold SSH connections to devpods
set -gx DEVPOD_NO_SSHWRAP 1
{{- else }}
# =============================================================================
# Devpod
# =============================================================================

# Source system profile — single source of truth for DevPod/Uber env vars
# (sets SSH_AUTH_SOCK, GOPATH, JAVA_HOME, NVM, PATH additions, etc.)
__cached_replay profile "source /etc/profile"
{{- end }}

# Clean up any duplicate PATH entries from replayed shell configs
dedup_path

# =============================================================================
# Alias
# =============================================================================

function opencode --wraps='aifx agent run opencode' --description 'Run opencode via aifx'
    set -q TMUX; and tmux rename-window opencode
    aifx agent run opencode $argv
    set -q TMUX; and tmux set-option -w automatic-rename on
end

function claude --wraps='aifx agent run claude' --description 'Run claude via aifx'
    set -q TMUX; and tmux rename-window claude
    aifx agent run claude $argv
    set -q TMUX; and tmux set-option -w automatic-rename on
end

# =============================================================================
# Vars
# =============================================================================

set -gx AIFX_ENABLE_DECLARATIVE_AGENT true
set -gx AIFX_ENABLE_PRIVATE_PREVIEW_FEATURES true


{{- end }}
