#!/usr/bin/env bash
# Configure fish as login shell after package managers install it.
# profiles.yaml hash: {{ include ".chezmoidata/profiles.yaml" | sha256sum }}

set -euo pipefail

# shellcheck source=/dev/null
source "${CHEZMOI_SOURCE_DIR:-$(chezmoi source-path)}/scripts/lib/common.sh"

# Find fish binary — check well-known install paths, then fall back to PATH
FISH_PATH=""
for p in /opt/homebrew/bin/fish /usr/local/bin/fish \
         /home/linuxbrew/.linuxbrew/bin/fish "$HOME/.linuxbrew/bin/fish" \
         /usr/bin/fish; do
    if [[ -x "$p" ]]; then
        FISH_PATH="$p"
        break
    fi
done

if [[ -z "$FISH_PATH" ]]; then
    FISH_PATH="$(command -v fish 2>/dev/null || true)"
fi

if [[ -z "$FISH_PATH" || ! -x "$FISH_PATH" ]]; then
    warn "fish not found — skipping shell setup"
    exit 0
fi

# Check current login shell early — nothing to do if already fish
current_shell() {
{{ if eq .chezmoi.os "darwin" -}}
    dscl . -read /Users/"$(whoami)" UserShell | awk '{print $2}'
{{ else -}}
    getent passwd "$(whoami)" | cut -d: -f7
{{ end -}}
}

if grep -qxF "$FISH_PATH" /etc/shells 2>/dev/null && [[ "$(current_shell)" == "$FISH_PATH" ]]; then
    log "fish is already the login shell — nothing to do"
    exit 0
fi

# Add fish to /etc/shells if not already present (needs sudo)
if ! grep -qxF "$FISH_PATH" /etc/shells 2>/dev/null; then
    if sudo -n true 2>/dev/null; then
        log "Adding $FISH_PATH to /etc/shells"
        echo "$FISH_PATH" | sudo tee -a /etc/shells >/dev/null
    else
        warn "$FISH_PATH is not in /etc/shells — run manually:"
        warn "  echo '$FISH_PATH' | sudo tee -a /etc/shells"
        exit 0
    fi
fi

# Set fish as login shell
if [[ "$(current_shell)" != "$FISH_PATH" ]]; then
    if sudo -n true 2>/dev/null; then
        log "Setting login shell to $FISH_PATH"
        sudo usermod -s "$FISH_PATH" "$(whoami)"
    else
        warn "Login shell is not $FISH_PATH — run manually:"
        warn "  sudo usermod -s '$FISH_PATH' $(whoami)"
    fi
fi
