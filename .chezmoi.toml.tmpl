{{- /* Profile-driven machine configuration for chezmoi
     Profile is selected interactively during chezmoi init, or via:
       DOTFILES_PROFILE=arch chezmoi init
       chezmoi init --promptChoice profile=arch
     Auto-detects from distro if non-interactive.
*/ -}}

{{- /* Detect distribution */ -}}
{{- $distro := "unknown" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $distro = "macos" -}}
{{- else if stat "/run/ostree-booted" -}}
{{-   $distro = "silverblue" -}}
{{- else if stat "/etc/arch-release" -}}
{{-   $distro = "arch" -}}
{{- else if stat "/etc/fedora-release" -}}
{{-   $distro = "fedora" -}}
{{- else if stat "/etc/debian_version" -}}
{{-   $distro = "debian" -}}
{{- end -}}

{{- /* Auto-detect default profile from distro */ -}}
{{- $defaultProfile := $distro -}}
{{- if eq $distro "macos" -}}
{{-   $defaultProfile = "macos-personal" -}}
{{- end -}}

{{- /* Resolve profile: env var > interactive prompt > auto-detect */ -}}
{{- $envProfile := env "DOTFILES_PROFILE" -}}
{{- $profile := "" -}}
{{- if ne $envProfile "" -}}
{{-   $profile = $envProfile -}}
{{- else -}}
{{-   $choices := list
       "arch"
       "debian-brew"
       "debian-dev"
       "debian-server"
       "devpod"
       "fedora"
       "macos-personal"
       "macos-work"
       "silverblue" -}}
{{-   writeToStdout "\nAvailable profiles:\n" -}}
{{-   writeToStdout "  arch               Arch Linux desktop — paru + flatpak\n" -}}
{{-   writeToStdout "  debian-brew        Debian/Ubuntu dev — Homebrew + flatpak\n" -}}
{{-   writeToStdout "  debian-dev         Debian/Ubuntu dev — CLI + dev tools via apt\n" -}}
{{-   writeToStdout "  debian-server      Debian/Ubuntu server — CLI tools only\n" -}}
{{-   writeToStdout "  devpod             Work devpod — dev tools via Homebrew\n" -}}
{{-   writeToStdout "  fedora             Fedora Workstation — dnf + flatpak\n" -}}
{{-   writeToStdout "  macos-personal     Personal Mac — full dev + GUI\n" -}}
{{-   writeToStdout "  macos-work         Work Mac — corporate dev + GUI\n" -}}
{{-   writeToStdout "  silverblue         Silverblue/Bazzite — immutable desktop\n" -}}
{{-   writeToStdout "\n" -}}
{{-   $profile = promptChoiceOnce . "profile" "Machine profile" $choices $defaultProfile -}}
{{- end -}}

{{- /*
  Derive profile properties. These duplicate profiles.yaml because chezmoi
  renders this config template before .chezmoidata is available. The profile
  name is the single input; everything below is a pure function of it.

  If you add a new profile to profiles.yaml, update the lists below too.
*/ -}}
{{- $tier3 := list "arch" "fedora" "macos-personal" "macos-work" "silverblue" -}}
{{- $tier1 := list "debian-server" -}}
{{- $tier := 2 -}}
{{- if has $profile $tier3 -}}{{- $tier = 3 -}}
{{- else if has $profile $tier1 -}}{{- $tier = 1 -}}
{{- end -}}

{{- $decrypt := has $profile (list "arch" "debian-brew" "debian-dev" "fedora" "macos-personal" "macos-work" "silverblue") -}}
{{- $isWork := has $profile (list "devpod" "macos-work") -}}

{{ if $decrypt -}}
encryption = "age"
{{ end }}
[data]
    distro = "{{ $distro }}"
    profile = "{{ $profile }}"
    tier = {{ $tier }}
    is_work = {{ $isWork }}
    decrypt = {{ $decrypt }}
{{ if $decrypt }}
[age]
    identity = "~/.config/chezmoi/age-key.txt"
    recipient = "{{ include ".age-public-key" | trim }}"
{{- end }}