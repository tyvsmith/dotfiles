{{- /* Machine type configuration for chezmoi

     Set via environment variables or install.sh:
       DOTFILES_IS_DEV=1 chezmoi init
       DOTFILES_UI_APPS=1 chezmoi init
       DOTFILES_DECRYPT=1 chezmoi init
       DOTFILES_IS_WORK=1 chezmoi init
       DOTFILES_HOMEBREW=1 chezmoi init
       DOTFILES_PROFILE=arch chezmoi init

     Or use install.sh for interactive prompts.
*/ -}}

{{- $envIsDev := lower (env "DOTFILES_IS_DEV") -}}
{{- $envUIApps := lower (env "DOTFILES_UI_APPS") -}}
{{- $envDecrypt := lower (env "DOTFILES_DECRYPT") -}}
{{- $envIsWork := lower (env "DOTFILES_IS_WORK") -}}
{{- $envHomebrew := lower (env "DOTFILES_HOMEBREW") -}}
{{- $envProfile := lower (env "DOTFILES_PROFILE") -}}

{{- /* Use env vars, fall back to existing config, default to false */ -}}
{{- $isDev := false -}}
{{- $installUIApps := false -}}
{{- $shouldDecrypt := false -}}
{{- $isWork := false -}}
{{- $homebrew := false -}}

{{- if ne $envIsDev "" -}}
{{-   $isDev = or (eq $envIsDev "1") (eq $envIsDev "true") -}}
{{- else if hasKey .chezmoi.config.data "is_dev" -}}
{{-   $isDev = .chezmoi.config.data.is_dev -}}
{{- end -}}

{{- if ne $envUIApps "" -}}
{{-   $installUIApps = or (eq $envUIApps "1") (eq $envUIApps "true") -}}
{{- else if hasKey .chezmoi.config.data "install_ui_apps" -}}
{{-   $installUIApps = .chezmoi.config.data.install_ui_apps -}}
{{- end -}}

{{- if ne $envDecrypt "" -}}
{{-   $shouldDecrypt = or (eq $envDecrypt "1") (eq $envDecrypt "true") -}}
{{- else if hasKey .chezmoi.config.data "should_decrypt" -}}
{{-   $shouldDecrypt = .chezmoi.config.data.should_decrypt -}}
{{- end -}}

{{- if ne $envIsWork "" -}}
{{-   $isWork = or (eq $envIsWork "1") (eq $envIsWork "true") -}}
{{- else if hasKey .chezmoi.config.data "is_work" -}}
{{-   $isWork = .chezmoi.config.data.is_work -}}
{{- end -}}

{{- if ne $envHomebrew "" -}}
{{-   $homebrew = or (eq $envHomebrew "1") (eq $envHomebrew "true") -}}
{{- else if hasKey .chezmoi.config.data "homebrew" -}}
{{-   $homebrew = .chezmoi.config.data.homebrew -}}
{{- end -}}

{{- /* Detect distribution for package manager selection
     Order matters: Silverblue before Fedora, Arch before Debian */ -}}
{{- $distro := "unknown" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $distro = "macos" -}}
{{- else if stat "/run/ostree-booted" -}}
{{-   $distro = "silverblue" -}}
{{- else if stat "/etc/arch-release" -}}
{{-   $distro = "arch" -}}
{{- else if stat "/etc/fedora-release" -}}
{{-   $distro = "fedora" -}}
{{- else if stat "/etc/debian_version" -}}
{{-   $distro = "debian" -}}
{{- end -}}

{{- /* Compute package profile from distro + flags, or use explicit override */ -}}
{{- $profile := $distro -}}
{{- if and (eq $distro "debian") $homebrew -}}
{{-   $profile = "debian-brew" -}}
{{- end -}}
{{- if ne $envProfile "" -}}
{{-   $profile = $envProfile -}}
{{- else if hasKey .chezmoi.config.data "profile" -}}
{{-   $profile = .chezmoi.config.data.profile -}}
{{- end -}}

{{ if $shouldDecrypt -}}
encryption = "age"
{{ end }}
[data]
    distro = "{{ $distro }}"
    profile = "{{ $profile }}"
    is_dev = {{ $isDev }}
    install_ui_apps = {{ $installUIApps }}
    should_decrypt = {{ $shouldDecrypt }}
    is_work = {{ $isWork }}
    homebrew = {{ $homebrew }}
{{ if $shouldDecrypt }}
[age]
    identity = "~/.config/chezmoi/age-key.txt"
    recipient = "{{ include ".age-public-key" | trim }}"
{{- end }}
