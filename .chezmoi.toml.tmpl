{{- /* Profile-driven machine configuration for chezmoi
     Profile is selected interactively during chezmoi init, or via:
       DOTFILES_PROFILE=arch chezmoi init
       chezmoi init --promptChoice profile=arch
     Auto-detects from distro if non-interactive.
*/ -}}

{{- /* Detect distribution and map to default profile */ -}}
{{- $distro := "unknown" -}}
{{- $defaultProfile := "" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $distro = "macos" -}}
{{-   $defaultProfile = "macos-work" -}}
{{- else if stat "/run/ostree-booted" -}}
{{-   $distro = "silverblue" -}}
{{-   $defaultProfile = "silverblue" -}}
{{- else if stat "/etc/arch-release" -}}
{{-   $distro = "arch" -}}
{{-   $defaultProfile = "arch-desktop" -}}
{{- else if stat "/etc/debian_version" -}}
{{-   $distro = "debian" -}}
{{-   $defaultProfile = "debian-server" -}}
{{- end -}}

{{- /* Resolve profile: env var > interactive prompt > auto-detect */ -}}
{{- $envProfile := env "DOTFILES_PROFILE" -}}
{{- $profile := "" -}}
{{- if ne $envProfile "" -}}
{{-   $profile = $envProfile -}}
{{- else -}}
{{-   $choices := list
       "arch-desktop"
       "debian-devpod"
       "debian-server"
       "macos-work"
       "silverblue" -}}
{{-   writeToStdout "\nAvailable profiles:\n" -}}
{{-   writeToStdout "  arch-desktop       Arch Linux desktop — paru + flatpak\n" -}}
{{-   writeToStdout "  debian-devpod      Debian/Ubuntu dev — CLI + dev tools via apt\n" -}}
{{-   writeToStdout "  debian-server      Debian/Ubuntu server — CLI tools only\n" -}}
{{-   writeToStdout "  macos-work         Work Mac — corporate dev + GUI\n" -}}
{{-   writeToStdout "  silverblue         Silverblue/Bazzite — immutable desktop\n" -}}
{{-   writeToStdout "\n" -}}
{{-   $profile = promptChoiceOnce . "profile" "Machine profile" $choices $defaultProfile -}}
{{- end -}}

{{- /*
  Derive profile properties. These duplicate profiles.yaml because chezmoi
  renders this config template before .chezmoidata is available. The profile
  name is the single input; everything below is a pure function of it.

  If you add a new profile to profiles.yaml, update the lists below too.
*/ -}}
{{- $tier7 := list "arch-desktop" "macos-work" "silverblue" -}}
{{- $tier1 := list "debian-server" -}}
{{- $tier := 3 -}}
{{- if has $profile $tier7 -}}{{- $tier = 7 -}}
{{- else if has $profile $tier1 -}}{{- $tier = 1 -}}
{{- end -}}

{{- $wantsDecrypt := has $profile (list "arch-desktop" "debian-devpod" "macos-work" "silverblue") -}}
{{- $work := has $profile (list "macos-work") -}}

{{- /* Enable encryption only when the key file exists. The decrypt data flag
     reflects whether the profile WANTS decryption (so run_before scripts can
     try to fetch the key). On first run without a key, the decrypt script
     warns and encrypted files are skipped via .chezmoiignore. After placing
     the key, re-run chezmoi init to enable decryption. */ -}}
{{- $ageKeyPath := joinPath .chezmoi.homeDir ".config" "chezmoi" "age-key.txt" -}}
{{- $hasKey := stat $ageKeyPath -}}

{{ if and $wantsDecrypt $hasKey -}}
encryption = "age"
{{ end }}
[data]
    distro = "{{ $distro }}"
    profile = "{{ $profile }}"
    tier = {{ $tier }}
    work = {{ $work }}
    decrypt = {{ $wantsDecrypt }}
    decrypt_active = {{ not (not (and $wantsDecrypt $hasKey)) }}
{{ if and $wantsDecrypt $hasKey }}
[age]
    identity = "~/.config/chezmoi/age-key.txt"
    recipient = "{{ include ".age-public-key" | trim }}"
{{- end }}