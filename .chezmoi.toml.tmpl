{{- /* Profile-driven machine configuration for chezmoi
     Select profile via environment variable or install.sh:
       DOTFILES_PROFILE=arch chezmoi init
     Auto-detects from distro if not specified.
*/ -}}

{{- /* Detect distribution */ -}}
{{- $distro := "unknown" -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $distro = "macos" -}}
{{- else if stat "/run/ostree-booted" -}}
{{-   $distro = "silverblue" -}}
{{- else if stat "/etc/arch-release" -}}
{{-   $distro = "arch" -}}
{{- else if stat "/etc/fedora-release" -}}
{{-   $distro = "fedora" -}}
{{- else if stat "/etc/debian_version" -}}
{{-   $distro = "debian" -}}
{{- end -}}

{{- /* Resolve profile: env var > existing config > auto-detect from distro */ -}}
{{- $envProfile := env "DOTFILES_PROFILE" -}}
{{- $profile := "" -}}
{{- if ne $envProfile "" -}}
{{-   $profile = $envProfile -}}
{{- else if hasKey .chezmoi.config.data "profile" -}}
{{-   $profile = .chezmoi.config.data.profile -}}
{{- else -}}
{{-   if eq $distro "macos" -}}
{{-     $profile = "macos-personal" -}}
{{-   else -}}
{{-     $profile = $distro -}}
{{-   end -}}
{{- end -}}

{{- /* Look up profile and extract properties */ -}}
{{- $p := index .profiles $profile -}}
{{- $tier := int (default 1 (index $p "tier")) -}}
{{- $isWork := false -}}{{- if hasKey $p "is_work" }}{{ $isWork = $p.is_work }}{{ end -}}
{{- $decrypt := false -}}{{- if hasKey $p "decrypt" }}{{ $decrypt = $p.decrypt }}{{ end -}}

{{ if $decrypt -}}
encryption = "age"
{{ end }}
[data]
    distro = "{{ $distro }}"
    profile = "{{ $profile }}"
    tier = {{ $tier }}
    is_work = {{ $isWork }}
    decrypt = {{ $decrypt }}
{{ if $decrypt }}
[age]
    identity = "~/.config/chezmoi/age-key.txt"
    recipient = "{{ include ".age-public-key" | trim }}"
{{- end }}
