# =============================================================================
# Auto-generated from .chezmoidata/packages.yaml — edit that file, not this one
# =============================================================================

# --- Taps ---
{{- range $name, $pkg := .packages }}
{{-   if hasKey $pkg "brew_tap" }}
{{-     if or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) "darwin") }}
tap "{{ $pkg.brew_tap }}"
{{-     end }}
{{-   end }}
{{- end }}

# =============================================================================
# Tier 1: Core CLI Tools — installed on ALL machines
# =============================================================================
{{- range $name, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 1) (hasKey $pkg "brew") }}
{{-     if not (hasKey $pkg "os") }}
brew "{{ $pkg.brew }}"  # {{ $pkg.desc }}
{{-     end }}
{{-   end }}
{{- end }}

{{ if .is_dev -}}
# =============================================================================
# Tier 2: Development Tools (is_dev=true)
# =============================================================================
{{- range $name, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 2) (hasKey $pkg "brew") }}
{{-     if not (hasKey $pkg "os") }}
brew "{{ $pkg.brew }}"  # {{ $pkg.desc }}
{{-     end }}
{{-   end }}
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# macOS-only: GNU tools (Linux has these natively)
{{- range $name, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 2) (hasKey $pkg "os") }}
{{-     if eq $pkg.os "darwin" }}
brew "{{ $pkg.brew }}"
{{-     end }}
{{-   end }}
{{- end }}
{{ end -}}
{{ end -}}

{{ if and (eq .chezmoi.os "darwin") .install_ui_apps -}}
# =============================================================================
# Tier 3: GUI Applications (macOS casks)
# =============================================================================
{{- range $name, $pkg := .packages }}
{{-   if and (eq (int $pkg.tier) 3) (hasKey $pkg "brew_cask") }}
{{-     if not (hasKey $pkg "os") }}
cask "{{ $pkg.brew_cask }}"  # {{ $pkg.desc }}
{{-     else if eq $pkg.os "darwin" }}
cask "{{ $pkg.brew_cask }}"  # {{ $pkg.desc }}
{{-     end }}
{{-   end }}
{{- end }}

# Mac App Store
brew "mas"
{{- range $name, $pkg := .packages }}
{{-   if hasKey $pkg "mas" }}
mas "{{ $pkg.desc }}", id: {{ $pkg.mas }}
{{-   end }}
{{- end }}
{{ end -}}
