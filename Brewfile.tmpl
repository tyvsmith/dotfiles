# =============================================================================
# Auto-generated from .chezmoidata/packages.yaml — edit that file, not this one
# =============================================================================

# --- Taps ---
{{- range $key, $pkg := .packages }}
{{-   if hasKey $pkg "brew_tap" }}
{{-     if or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) .chezmoi.os) }}
tap "{{ $pkg.brew_tap }}"
{{-     end }}
{{-   end }}
{{- end }}

# --- Formulas ---
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $bn := default $n (index $pkg "brew_name") }}
{{-   if and
        (le (int $pkg.tier) (int $.tier))
        (or (not (hasKey $pkg "brew")) $pkg.brew)
        (not (and (hasKey $pkg "brew_cask") $pkg.brew_cask))
        (or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) $.chezmoi.os))
}}
brew "{{ $bn }}"  # {{ $pkg.desc }}
{{-   end }}
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# --- Casks ---
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $bn := default $n (index $pkg "brew_name") }}
{{-   if and
        (le (int $pkg.tier) (int $.tier))
        (or (not (hasKey $pkg "brew")) $pkg.brew)
        (and (hasKey $pkg "brew_cask") $pkg.brew_cask)
        (or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) "darwin"))
}}
cask "{{ $bn }}"  # {{ $pkg.desc }}
{{-   end }}
{{- end }}

# --- Mac App Store ---
brew "mas"
{{- range $key, $pkg := .packages }}
{{-   if and (le (int $pkg.tier) (int $.tier)) (hasKey $pkg "mas") }}
mas "{{ $pkg.desc }}", id: {{ $pkg.mas }}
{{-   end }}
{{- end }}
{{ end -}}
