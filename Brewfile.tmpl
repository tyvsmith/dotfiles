# =============================================================================
# Auto-generated from .chezmoidata/packages.yaml — edit that file, not this one
# =============================================================================

# --- Taps ---
{{- range $key, $pkg := .packages }}
{{-   if hasKey $pkg "brew_tap" }}
{{-     if or (not (hasKey $pkg "os")) (eq (default "" $pkg.os) "darwin") }}
tap "{{ $pkg.brew_tap }}"
{{-     end }}
{{-   end }}
{{- end }}

# =============================================================================
# Tier 1: Core CLI Tools — installed on ALL machines
# =============================================================================
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $bn := default $n (index $pkg "brew_name") }}
{{-   if and (eq (int $pkg.tier) 1) (not (hasKey $pkg "os")) (or (not (hasKey $pkg "brew")) $pkg.brew) (not (and (hasKey $pkg "brew_cask") $pkg.brew_cask)) }}
brew "{{ $bn }}"  # {{ $pkg.desc }}
{{-   end }}
{{- end }}

{{ if .is_dev -}}
# =============================================================================
# Tier 2: Development Tools (is_dev=true)
# =============================================================================
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $bn := default $n (index $pkg "brew_name") }}
{{-   if and (eq (int $pkg.tier) 2) (not (hasKey $pkg "os")) (or (not (hasKey $pkg "brew")) $pkg.brew) }}
brew "{{ $bn }}"  # {{ $pkg.desc }}
{{-   end }}
{{- end }}

{{ if eq .chezmoi.os "darwin" -}}
# macOS-only: GNU tools (Linux has these natively)
{{- range $key, $pkg := .packages }}
{{-   $n := default $key (index $pkg "name") }}
{{-   $bn := default $n (index $pkg "brew_name") }}
{{-   if and (eq (int $pkg.tier) 2) (hasKey $pkg "os") (eq $pkg.os "darwin") }}
brew "{{ $bn }}"
{{-   end }}
{{- end }}
{{ end -}}
{{ end -}}

{{- /* Tier 3 (GUI apps) is handled separately by run_onchange_03-install-ui-apps.sh.tmpl */ -}}
